{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "wfgg-api-lastwar-preview",
  "main": "src/index-lastwar-preview.js",
  "compatibility_date": "2026-08-20",
  "keep_vars": true,
  "vars": {
    "PORTAL_ORIGINS": "https://portal-auth-lastwar-lab-v1.wfgg.pages.dev"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "wfgg-db-lastwar-preview",
      "database_id": "REPLACE_WITH_DEDICATED_PREVIEW_D1_ID"
    }
  ]
}
