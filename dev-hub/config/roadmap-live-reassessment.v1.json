{
  "schema": "chacha.dev/roadmap-live-reassessment/v1",
  "version": "1.0.0",
  "rules": {
    "incident-remediation": {
      "stages": [
        {
          "target_progress": 85,
          "status": "ORANGE",
          "state": "HUMAN_REMEDIATION_PLAN_ACTIVE",
          "required_release_paths": [
            "dev-hub/bin/human-remediation-plan.py",
            "dev-hub/config/human-remediation-planning.v1.json"
          ]
        },
        {
          "target_progress": 95,
          "status": "ORANGE",
          "state": "SAFE_NON_DESTRUCTIVE_REMEDIATION_ROUTING_ACTIVE",
          "required_release_paths": [
            "dev-hub/bin/incident-safe-remediation-router.py",
            "dev-hub/bin/progress-state-recovery.py"
          ]
        },
        {
          "target_progress": 100,
          "status": "GREEN",
          "state": "SAFE_AUTOREMEDIATION_PROVED",
          "required_release_paths": [
            "dev-hub/bin/incident-safe-remediation-router.py",
            "dev-hub/bin/progress-state-recovery.py"
          ],
          "required_runtime_jsons": [
            {
              "path": "autonomy-evidence/incident-safe-remediation.json",
              "field": "status",
              "equals": "PASS"
            }
          ]
        }
      ]
    },
    "foundries": {
      "stages": [
        {
          "target_progress": 95,
          "status": "ORANGE",
          "state": "PILOT_TO_CHANGESET_ACTIVE",
          "required_release_paths": [
            "dev-hub/bin/foundry-pilot-change-set.py",
            "dev-hub/config/foundry-pilot-change-set.v1.json"
          ]
        },
        {
          "target_progress": 100,
          "status": "GREEN",
          "state": "FOUNDRY_SHADOW_GRADUATION_PROVED",
          "required_release_paths": [
            "dev-hub/bin/foundry-shadow-graduation-gate.py",
            "dev-hub/bin/foundry-pilot-change-set.py"
          ],
          "required_runtime_jsons": [
            {
              "path": "autonomy-evidence/foundry-graduation.json",
              "field": "status",
              "equals": "PASS"
            }
          ]
        }
      ]
    },
    "learning": {
      "stages": [
        {
          "target_progress": 90,
          "status": "ORANGE",
          "state": "LEARNING_COVERAGE_AUDIT_ACTIVE",
          "required_release_paths": [
            "dev-hub/bin/learning-coverage-auditor.py",
            "dev-hub/config/learning-coverage-audit.v1.json"
          ]
        },
        {
          "target_progress": 100,
          "status": "GREEN",
          "state": "COGNITIVE_OUTCOME_LEARNING_PROVED",
          "required_release_paths": [
            "dev-hub/bin/cognitive-route-outcome-learning.py",
            "dev-hub/bin/model-capability-confidence.py"
          ],
          "required_runtime_jsons": [
            {
              "path": "autonomy-evidence/cognitive-shadow-learning.json",
              "field": "status",
              "equals": "PASS"
            }
          ]
        }
      ]
    },
    "provider-independence": {
      "stages": [
        {
          "target_progress": 50,
          "status": "RED",
          "state": "LOCAL_FALLBACK_GATE_ACTIVE_RUNTIME_MISSING",
          "required_release_paths": [
            "dev-hub/bin/local-cognitive-fallback-gate.py",
            "dev-hub/config/local-cognitive-fallback.v1.json"
          ]
        },
        {
          "target_progress": 70,
          "status": "ORANGE",
          "state": "ADAPTIVE_MULTI_GATEWAY_ROUTING_ACTIVE_LOCAL_RUNTIME_MISSING",
          "required_release_paths": [
            "dev-hub/bin/adaptive-cognitive-router.py",
            "dev-hub/config/adaptive-cognitive-routing.v1.json",
            "dev-hub/config/adaptive-cognitive-gateways.v1.json"
          ]
        },
        {
          "target_progress": 100,
          "status": "GREEN",
          "state": "LOCAL_COGNITIVE_RUNTIME_PROVED",
          "required_runtime_json": {
            "path": "local-cognitive-fallback/readiness.json",
            "field": "status",
            "equals": "PASS"
          }
        },
        {
          "target_progress": 85,
          "status": "ORANGE",
          "state": "LOCAL_COGNITIVE_SHADOW_PROVED_NOT_ACTIVE",
          "required_release_paths": [
            "dev-hub/bin/native-local-resource-admission.py",
            "dev-hub/bin/adaptive-model-registry.py",
            "dev-hub/bin/native-local-shadow-soak.py"
          ],
          "required_runtime_jsons": [
            {
              "path": "autonomy-evidence/native-local-shadow.json",
              "field": "status",
              "equals": "PASS"
            }
          ]
        }
      ]
    },
    "persistent-missions": {
      "stages": [
        {
          "target_progress": 90,
          "status": "ORANGE",
          "state": "PERSISTENT_MISSION_CONTROLLER_ACTIVE",
          "required_release_paths": [
            "dev-hub/bin/persistent-mission-controller.py",
            "dev-hub/config/persistent-missions.v1.json"
          ]
        },
        {
          "target_progress": 95,
          "status": "ORANGE",
          "state": "MISSION_GOAL_SCHEDULER_BRIDGE_ACTIVE",
          "required_release_paths": [
            "dev-hub/bin/persistent-mission-goal-monitor.py",
            "dev-hub/bin/persistent-mission-scheduler-bridge.py"
          ]
        },
        {
          "target_progress": 100,
          "status": "GREEN",
          "state": "PERSISTENT_MISSION_E2E_RESUME_PROVED",
          "required_release_paths": [
            "dev-hub/bin/persistent-mission-goal-monitor.py",
            "dev-hub/bin/persistent-mission-scheduler-bridge.py"
          ],
          "required_runtime_jsons": [
            {
              "path": "autonomy-evidence/persistent-mission-e2e.json",
              "field": "status",
              "equals": "PASS"
            }
          ]
        }
      ]
    },
    "self-evolution": {
      "stages": [
        {
          "target_progress": 90,
          "status": "ORANGE",
          "state": "FOUNDRY_CHANGESET_GATE_ACTIVE",
          "required_release_paths": [
            "dev-hub/bin/foundry-pilot-change-set.py",
            "dev-hub/config/foundry-pilot-change-set.v1.json"
          ]
        },
        {
          "target_progress": 100,
          "status": "GREEN",
          "state": "ROADMAP_TRAIN_AUTONOMOUS_PLANNING_PROVED",
          "required_release_paths": [
            "dev-hub/bin/roadmap-release-train-planner.py",
            "dev-hub/bin/roadmap-live-score-reconciler.py"
          ],
          "required_runtime_jsons": [
            {
              "path": "autonomy-evidence/roadmap-train-planning.json",
              "field": "status",
              "equals": "PASS"
            }
          ]
        }
      ]
    },
    "constitution": {
      "stages": [
        {
          "target_progress": 95,
          "status": "ORANGE",
          "state": "CONSTITUTION_INDEX_ACTIVE",
          "required_release_paths": [
            "dev-hub/bin/autonomy_constitution.py",
            "dev-hub/config/autonomy-constitution.v1.json"
          ]
        },
        {
          "target_progress": 100,
          "status": "GREEN",
          "state": "CONSTITUTION_CONTINUOUS_DRIFT_WATCH_PROVED",
          "required_release_paths": [
            "dev-hub/bin/autonomy-constitution-drift-watch.py"
          ],
          "required_runtime_jsons": [
            {
              "path": "autonomy-evidence/constitution-watch.json",
              "field": "status",
              "equals": "PASS"
            }
          ]
        }
      ]
    },
    "resilience-ha": {
      "stages": [
        {
          "target_progress": 40,
          "status": "RED",
          "state": "HA_READINESS_GATE_ACTIVE_STANDBY_MISSING",
          "required_release_paths": [
            "dev-hub/bin/ha-readiness-gate.py",
            "dev-hub/config/ha-readiness.v1.json"
          ]
        },
        {
          "target_progress": 65,
          "status": "ORANGE",
          "state": "PASSIVE_STANDBY_TOPOLOGY_ACTIVE_FAILOVER_PILOT_PENDING",
          "required_release_paths": [
            "dev-hub/bin/ha-standby-manifest-builder.py",
            "dev-hub/config/ha-standby-profile.v1.json"
          ]
        },
        {
          "target_progress": 80,
          "status": "ORANGE",
          "state": "STANDBY_HA_READY_FOR_GOVERNED_FAILOVER_PILOT",
          "required_runtime_json": {
            "path": "ha/standby-readiness.json",
            "field": "status",
            "equals": "PASS",
            "release_revision_field": "platform_revision"
          }
        },
        {
          "target_progress": 100,
          "status": "GREEN",
          "state": "GOVERNED_FAILOVER_PILOT_PROVED",
          "required_runtime_json": {
            "path": "ha/failover-pilot.json",
            "field": "status",
            "equals": "PASS",
            "release_revision_field": "platform_revision"
          }
        },
        {
          "target_progress": 90,
          "status": "ORANGE",
          "state": "HA_STANDBY_REHEARSAL_PROVED_NO_FAILOVER",
          "required_release_paths": [
            "dev-hub/bin/ha-standby-rehearsal.py"
          ],
          "required_runtime_jsons": [
            {
              "path": "autonomy-evidence/ha-rehearsal.json",
              "field": "status",
              "equals": "PASS",
              "release_revision_field": "platform_revision"
            }
          ]
        }
      ]
    }
  },
  "automatic_external_spend_eur": 0
}
