{
  "schema": "chacha.dev/nas-incremental-image-vault/v1",
  "version": "1.2.0",
  "mode": "SHADOW_READY",
  "purpose": "Keep reconstructible, versioned ChaCha DEV logical images on the 18 TB NAS volume using the 4 TB ChaCha persistence volume as source.",
  "nas_host": "chachanas",
  "source_root": "/share/CACHEDEV1_DATA/ChaCha-DEV-HUB",
  "vault_root": "/share/CACHEDEV2_DATA/ChaCha-DEV-Image-Vault",
  "images_dir": "images",
  "manifests_dir": "manifests",
  "core_capsule": {
    "source_path": "backups/core-capsule/current",
    "git_bundle_required": true,
    "active_release_archive_required": true,
    "sqlite_backup_api_required": true,
    "secrets_forbidden": true,
    "runtime_databases": [
      "/opt/chacha-dev/runtime/sovereign-state/primary/guardian.db",
      "/opt/chacha-dev/runtime/sovereign-state/primary/sentinel.db",
      "/opt/chacha-dev/runtime/sovereign-state/primary/assurance-exchange.db",
      "/opt/chacha-dev/runtime/knowledge/central-memory-assimilation.db",
      "/opt/chacha-dev/runtime/knowledge/learning-deltas.db",
      "/opt/chacha-dev/runtime/agent-observation/observations.db"
    ],
    "git_reconstruction_source": {
      "mode": "DEDICATED_COMPLETE_BARE_REPOSITORY",
      "path": "/opt/chacha-dev/runtime/nas-image-vault/git-reconstruction-source.git",
      "remote_url": "git@github.com:chachasan090375/WfGg.git",
      "active_branch": "chacha-active",
      "fetch_exact_active_revision": true,
      "require_non_shallow": true,
      "fsck_required": true,
      "bundle_clean_clone_probe_required": true,
      "network_refresh_only_when_snapshot_required": true,
      "production_workspace_may_remain_shallow": true
    }
  },
  "snapshot": {
    "strategy": "RSYNC_HARDLINK_INCREMENTAL",
    "rsync_flags": [
      "-aH",
      "--numeric-ids"
    ],
    "previous_image_link_dest": true,
    "atomic_publish": true,
    "source_delete_propagation_to_history": false
  },
  "verification": {
    "post_copy_rsync_dry_run_must_be_empty": true,
    "core_capsule_sha256_manifest_required": true,
    "restore_probe_required": true,
    "image_status_required": "RESTORE_VERIFIED",
    "clean_host_reconstruction_rehearsal_required": true,
    "bundle_must_clone_on_empty_host": true
  },
  "retention": {
    "automatic_prune_enabled": false,
    "target_policy": {
      "dense_hours": 48,
      "daily_days": 30,
      "weekly_weeks": 26,
      "monthly_months": 24
    },
    "prune_requires_intendant_plan": true,
    "destructive_prune_requires_guardian_and_human_gate": true
  },
  "authority": {
    "production_activation": false,
    "nas_source_mutation": "CORE_CAPSULE_ONLY",
    "nas_vault_write": true,
    "destructive_delete": false
  },
  "automatic_external_spend_eur": 0,
  "trigger_policy": {
    "mode": "EVENT_DRIVEN_DIRTY_MARKER",
    "periodic_snapshot_timer": false,
    "dirty_marker": "/opt/chacha-dev/runtime/nas-image-vault/dirty.json",
    "events": [
      "PLATFORM_PROMOTION_FINALIZED",
      "MANUAL_RECOVERY_POINT"
    ],
    "application_build_alone_marks_dirty": false,
    "unchanged_production_revision_skips_snapshot": true,
    "failure_preserves_dirty_marker": true,
    "success_clears_dirty_marker": true
  }
}
