{
  "schema": "chacha.dev/lifecycle/v1",
  "principles": {
    "evidence_over_claims": true,
    "no_stage_skip": true,
    "production_change_requires_approval": true,
    "blocking_gate_must_be_ok_or_not_applicable": true,
    "non_blocking_partial_requires_risk_acceptance_for_release": true,
    "state_change_is_auditable": true,
    "release_boundary_requires_signed_checkpoint": true,
    "retirement_boundary_requires_signed_checkpoint": true,
    "compromise_release_precedes_delivery": true,
    "final_delivery_requires_seven_agent_receipt": true
  },
  "stages": [
    "IDEA",
    "DESIGN",
    "READY",
    "BUILD",
    "VERIFY",
    "PREVIEW",
    "RELEASE",
    "OPERATE",
    "RETIRE"
  ],
  "transitions": {
    "IDEA->DESIGN": {
      "required_artifacts": [
        "project-intent"
      ],
      "required_approvals": [],
      "required_gates": [],
      "gate_policy": "none"
    },
    "DESIGN->READY": {
      "required_artifacts": [
        "project-plan",
        "manifest-v3",
        "manifest-validation",
        "capability-resolution",
        "architecture-decisions-resolved"
      ],
      "required_approvals": [],
      "required_gates": [],
      "gate_policy": "defined"
    },
    "READY->BUILD": {
      "required_artifacts": [
        "workspace-health",
        "storage-preflight",
        "dependency-resolution"
      ],
      "required_approvals": [],
      "required_gates": [],
      "gate_policy": "defined"
    },
    "BUILD->VERIFY": {
      "required_artifacts": [
        "change-set",
        "build-result",
        "static-check"
      ],
      "required_approvals": [],
      "required_gates": [],
      "gate_policy": "defined"
    },
    "VERIFY->PREVIEW": {
      "required_artifacts": [
        "test-result",
        "security-scan",
        "ci-result",
        "preview-candidate"
      ],
      "required_approvals": [],
      "required_gates": [
        "identity-security",
        "testing",
        "build-dependencies",
        "ci-cd-release"
      ],
      "gate_policy": "required-gates"
    },
    "PREVIEW->RELEASE": {
      "required_artifacts": [
        "preview-validation",
        "e2e-result",
        "smoke-result",
        "rollback-plan",
        "release-traceability",
        "backup-recovery-readiness",
        "signed-release-checkpoint",
        "trust-anchor-quorum",
        "seven-agent-finalization-inputs",
        "compromise-release-receipt",
        "seven-agent-final-delivery-receipt"
      ],
      "required_approvals": [
        "production-release"
      ],
      "required_gates": [
        "compromise-release"
      ],
      "gate_policy": "release+compromise"
    },
    "RELEASE->OPERATE": {
      "required_artifacts": [
        "production-deployment-receipt",
        "post-deploy-smoke",
        "production-health",
        "observability-health",
        "post-release-signed-checkpoint",
        "post-release-anchor-quorum"
      ],
      "required_approvals": [
        "production-deployment"
      ],
      "required_gates": [
        "identity-security",
        "ci-cd-release",
        "observability",
        "reliability-resilience"
      ],
      "gate_policy": "required-gates"
    },
    "OPERATE->RETIRE": {
      "required_artifacts": [
        "retirement-plan",
        "archive-proof",
        "data-disposition",
        "dependency-retirement-check",
        "signed-retirement-checkpoint",
        "retirement-anchor-quorum"
      ],
      "required_approvals": [
        "retirement"
      ],
      "required_gates": [
        "backup-recovery",
        "documentation",
        "operations-sre",
        "governance-compliance"
      ],
      "gate_policy": "required-gates"
    }
  },
  "release_policy": {
    "allowed_blocking_statuses": [
      "OK",
      "NOT_APPLICABLE"
    ],
    "allowed_non_blocking_statuses": [
      "OK",
      "PARTIAL",
      "NOT_APPLICABLE"
    ],
    "forbidden_statuses": [
      "MISSING",
      "UNVERIFIED"
    ],
    "risk_acceptance_required_for_non_blocking_partial": true,
    "signed_checkpoint_required": true,
    "minimum_independent_trust_anchors": 2,
    "compromise_release_receipt_required": true,
    "all_required_agent_reviews_must_be_accounted_for": true,
    "unresolved_agent_hard_objection_forbidden": true,
    "agent_revision_request_only_after_failed_central_compromise": true,
    "seven_agent_final_delivery_receipt_required": true,
    "five_external_reviews_source_reverified": true,
    "two_internal_post_implementation_reads_required": true,
    "automatic_seven_agent_finalization": true,
    "finalization_input_bundle_required": true
  },
  "emergency": {
    "hotfix_path": [
      "OPERATE",
      "BUILD",
      "VERIFY",
      "PREVIEW",
      "RELEASE",
      "OPERATE"
    ],
    "requires_incident_reference": true,
    "requires_production_approval": true,
    "post_hoc_evidence_deadline_hours": 24,
    "signed_checkpoint_still_required": true
  }
}
