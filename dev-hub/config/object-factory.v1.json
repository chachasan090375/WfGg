{
  "schema": "chacha.dev/object-factory-policy/v1",
  "version": "1.0.0",
  "scope": "APPLICATION_DOMAIN_OBJECTS",
  "owner": "component-factory",
  "architecture_owner": "chacha-dev-architect",
  "capability_gap_owner": "capability-foundry",
  "principles": {
    "reuse_before_build": true,
    "explicit_object_contract_required": true,
    "no_provider_selection_authority": true,
    "no_production_change_authority": true,
    "object_contract_before_code_generation": true,
    "relationships_must_be_explicit": true,
    "sensitive_fields_must_be_marked": true,
    "storage_mapping_is_a_plan_not_a_deployment": true,
    "automatic_external_spend_eur": 0,
    "canonical_component_registry_required": true,
    "universal_materialization_gate_required": true,
    "birth_contract_required": true,
    "retention_and_purge_contract_required": true
  },
  "supported_field_types": [
    "string",
    "integer",
    "number",
    "boolean",
    "datetime",
    "date",
    "uuid",
    "json",
    "binary",
    "reference"
  ],
  "supported_relationships": [
    "one-to-one",
    "one-to-many",
    "many-to-one",
    "many-to-many"
  ],
  "supported_persistence": [
    "none",
    "relational",
    "object-storage",
    "hybrid"
  ],
  "universal_materialization": {
    "policy": "dev-hub/config/canonical-component-registry.v1.json",
    "gate": "dev-hub/bin/universal-materialization-gate.py",
    "registry_builder": "dev-hub/bin/canonical_component_registry.py",
    "pre_registration_status": "PENDING_CANONICAL_REGISTRATION",
    "active_only_after_gate_pass": true,
    "automatic_external_spend_eur": 0
  }
}
