{
  "schema": "chacha.dev/dark-intelligence-agent-policy/v1",
  "version": "8.0.1",
  "agent_id": "dark-intelligence-agent",
  "scope": "PLATFORM_GLOBAL",
  "mode": "PASSIVE_READ_ONLY_INTELLIGENCE",
  "domains": [
    "knowledge-research",
    "cybersecurity"
  ],
  "source_classes": [
    "public_web",
    "deep_web",
    "tor_onion",
    "threat_intelligence_feed"
  ],
  "collection": {
    "network_isolation_required": true,
    "tor_or_proxy_capsule_required_for_tor_onion": true,
    "central_vps_direct_tor_access_forbidden": true,
    "read_only": true,
    "authentication_with_platform_credentials_forbidden": true,
    "purchases_forbidden": true,
    "contact_or_posting_forbidden": true,
    "payload_execution_forbidden": true,
    "downloaded_binary_quarantine_required": true,
    "automatic_external_spend_eur": 0,
    "isolated_collector": "dev-hub/bin/dark-intelligence-collector-runner.py",
    "collector_policy": "dev-hub/config/dark-intelligence-collector.v1.json",
    "source_content_is_untrusted_data": true,
    "source_instructions_never_executed": true,
    "prompt_injection_from_sources_must_be_ignored": true,
    "raw_html_execution_forbidden": true,
    "semantic_analysis_adapter": "dev-hub/bin/dark-intelligence-analysis-adapter.py",
    "end_to_end_pipeline": "dev-hub/bin/dark-intelligence-pipeline.py",
    "semantic_analysis_tool_access": false,
    "semantic_analysis_sandbox_required": true,
    "semantic_analysis_source_instruction_authority": false,
    "semantic_analysis_models": [
      "gemini-3.6-flash-medium",
      "gemini-3.8-flash-medium",
      "gemini-3.7-flash-medium"
    ],
    "semantic_analysis_provider_unavailable_behavior": "DEFERRED_PROVIDER_UNAVAILABLE",
    "semantic_analysis_retry_after_seconds": 900,
    "semantic_analysis_must_never_promote_without_result": true,
    "analysis_retry_queue": "dev-hub/bin/dark-intelligence-analysis-queue.py",
    "analysis_retry_timer": "dev-hub/systemd/chacha-dev-dark-intelligence-analysis-retry.timer",
    "analysis_retry_interval_seconds": 900,
    "analysis_retry_max_attempts": 12,
    "analysis_retry_infinite_loop_forbidden": true
  },
  "verification_pipeline": {
    "normalize_to_technology_dossier": true,
    "technology_watch_evaluation_required": true,
    "truth_scoring": "dev-hub/bin/technology_truth_scoring.py",
    "source_reputation": "dev-hub/bin/technology_source_reputation.py",
    "logician_falsification": "dev-hub/bin/technology_watch_logician.py",
    "evidence_independence_graph_required": true,
    "cross_source_corroboration_required_for_high_confidence": true,
    "architecture_council_final_authority": true,
    "guardian_required": true,
    "sentinel_required": true,
    "bastion_security_boundary_required": true,
    "unverified_source_never_becomes_fact": true,
    "collector_provenance_required": true,
    "semantic_analysis_claims_remain_unverified": true,
    "analysis_confidence_never_replaces_corroboration": true,
    "corroboration_gate": "dev-hub/bin/dark-intelligence-corroboration.py",
    "corroboration_policy": "dev-hub/config/dark-intelligence-corroboration.v1.json",
    "minimum_independent_support_groups": 2,
    "corroboration_search_role": "technology-watch-agent",
    "corroboration_search_capability": "web-research",
    "primary_dark_source_never_counts_as_independent_corroboration": true,
    "corroboration_failure_never_validates": true,
    "public_corroboration_policy": "dev-hub/config/dark-intelligence-public-corroboration.v1.json",
    "public_corroboration_adapter": "dev-hub/bin/technology-watch-public-corroboration.py",
    "public_corroboration_classifier": "dev-hub/bin/dark-intelligence-corroboration-analysis.py",
    "public_corroboration_provider": "exa-mcp",
    "public_corroboration_provider_status": "PILOT",
    "public_corroboration_automatic": true,
    "public_corroboration_provider_or_classifier_failure": "DEFERRED_PROVIDER_UNAVAILABLE",
    "public_corroboration_failure_auto_enqueue": true,
    "exa_search_result_has_fact_authority": false
  },
  "output": {
    "normalized_schema": "chacha.dev/dark-intelligence-dossier/v1",
    "technology_dossier_compatible": true,
    "raw_source_is_advisory_only": true,
    "provenance_required": true,
    "confidence_required": true
  }
}
