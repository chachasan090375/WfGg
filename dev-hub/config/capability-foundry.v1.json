{
  "schema": "chacha.dev/capability-foundry/v1",
  "version": "1.3.0",
  "purpose": "Create a missing platform capability or logical domain factory when the current kernel cannot satisfy a functional requirement.",
  "trigger": {
    "missing_registered_capability": true,
    "no_policy_eligible_provider": true,
    "repeated_project_specific_solution": true
  },
  "outputs": [
    "capability-definition",
    "domain-factory-definition",
    "provider-strategy",
    "collector-definition",
    "contracts",
    "fixtures",
    "sandbox-plan",
    "rollback-plan"
  ],
  "lifecycle": [
    "DISCOVER",
    "DESIGN",
    "BUILD",
    "QUALIFY",
    "PILOT",
    "ADOPT",
    "IMPROVE",
    "DEPRECATE",
    "RETIRE"
  ],
  "rules": {
    "reuse_existing_domain_when_possible": true,
    "create_new_domain_only_when_existing_domain_cannot_own_capability": true,
    "technology_watch_required": true,
    "architecture_competition_required_when_multiple_viable_patterns": true,
    "zero_incremental_cost_default": true,
    "sandbox_before_adopt": true,
    "rollback_required": true,
    "generic_collector_required": true,
    "no_project_secret_in_generic_factory": true,
    "core_replan_required_after_creation": true,
    "agent_foundry_rerun_required_after_creation": true,
    "technology_watch_consulted_on_every_materialization": true,
    "valid_zero_spend_candidates_dominate_nonzero_candidates": true,
    "central_memory_seeds_capability_design_candidates": true,
    "negative_component_confidence_excludes_fast_candidate_reuse": true,
    "memory_cannot_register_missing_capability_by_itself": true,
    "memory_never_skips_technology_watch": true,
    "architecture_council_remains_final_authority": true,
    "canonical_component_registry_required": true,
    "universal_materialization_gate_required": true,
    "birth_contract_required": true,
    "retention_and_purge_contract_required": true
  },
  "human_approval_only_for": [
    "new_external_spend",
    "credential_or_identity_boundary",
    "irreversible_migration",
    "security_boundary_reduction",
    "license_exception"
  ],
  "technology_watch": {
    "snapshot": "/opt/chacha-dev/runtime/technology-watch/optimizer-input.json",
    "maximum_snapshot_age_minutes": 60,
    "targeted_refresh_if_missing_or_stale": true,
    "automatic_external_spend_eur": 0
  },
  "platform_component_reassessment": {
    "mode": "PLATFORM_COMPONENT_REASSESSMENT",
    "stage": "SHADOW",
    "incumbent_is_control_group": true,
    "technology_watch_revalidation_required": true,
    "logician_falsification_required": true,
    "materialization_authorized_in_shadow": false,
    "active_component_mutation": false,
    "promotion_authorized_in_shadow": false,
    "permission_expansion": false,
    "guardian_required": true,
    "sentinel_required": true,
    "architecture_council_final_authority": true,
    "automatic_external_spend_eur": 0
  },
  "universal_materialization": {
    "policy": "dev-hub/config/canonical-component-registry.v1.json",
    "gate": "dev-hub/bin/universal-materialization-gate.py",
    "registry_builder": "dev-hub/bin/canonical_component_registry.py",
    "pre_registration_status": "PENDING_CANONICAL_REGISTRATION",
    "active_only_after_gate_pass": true,
    "automatic_external_spend_eur": 0
  }
}
