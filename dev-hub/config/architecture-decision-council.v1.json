{
  "schema": "chacha.dev/architecture-decision-council-policy/v1",
  "version": "1.5.0",
  "central_orchestrator_is_final_decider": true,
  "no_single_foundry_may_select_final_architecture": true,
  "mandatory_advisors": [
    "technology-watch-pre",
    "architecture-memory",
    "architecture-portfolio",
    "reuse-memory",
    "branch-foundry",
    "agent-foundry",
    "capability-foundry",
    "constraint-policy",
    "technology-watch-final"
  ],
  "reuse": {
    "prefer_reuse_when_still_best": true,
    "qualification_required": "PASS",
    "state_required": "ADOPT",
    "maximum_technology_revalidation_age_minutes": 60,
    "stale_branch_action": "REVALIDATE_BEFORE_REUSE",
    "previous_version_is_candidate_not_default": true
  },
  "technology_watch": {
    "continuous_background_watch": true,
    "consult_before_foundry_synthesis": true,
    "consult_after_foundry_synthesis": true,
    "taxonomy_must_cover_all_known_domains_capabilities_and_reusable_branches": true,
    "material_signal_triggers_immediate_targeted_refresh": true,
    "taxonomy_must_cover_reusable_architectures": true
  },
  "experts": {
    "dynamic_on_demand": true,
    "permanent_expert_daemons": false,
    "derive_from_active_domains": true
  },
  "constraints": {
    "hard_before_scoring": true,
    "zero_spend_valid_solution_dominates_paid": true,
    "paid_requires_human_approval": true,
    "security_boundary_reduction_requires_human_approval": true,
    "rollback_required": true
  },
  "decision_memory": {
    "store_architecture_decision": true,
    "feed_global_project_memory": true,
    "feed_reusable_branch_registry_after_qualification": true,
    "record_rejected_alternatives": true,
    "feed_reusable_architecture_registry_after_qualification": true
  },
  "architecture_memory": {
    "exact_functional_signature_required": true,
    "qualification_required": "PASS",
    "state_required": "ADOPT",
    "maximum_technology_revalidation_age_minutes": 60,
    "minimum_success_rate": 0.95,
    "maximum_incident_count": 0,
    "use_as_baseline_candidate_only": true,
    "branch_level_fresher_evidence_can_override": true
  },
  "architecture_portfolio": {
    "optimizer_policy": "architecture-portfolio-optimizer.v1.json",
    "current_foundry_synthesis_always_compared": true,
    "fast_reuse_requires_current_foundry_agreement": true,
    "conflict_action": "COMPARATIVE_PILOT_REQUIRED",
    "conflict_blocks_production_dispatch": true
  },
  "logic_ux_challenge": {
    "required_in_v634_orchestrator": true,
    "central_compromise_must_precede_council": true,
    "current_plan_has_no_incumbency_privilege": true,
    "council_must_consume_compromise_dossier": true,
    "unresolved_compromise_blocks_dispatch": true,
    "agent_revision_only_after_failed_central_compromise": true
  },
  "agent_candidate_review": {
    "enabled": true,
    "owner_must_be": "agent-foundry",
    "evidence_complete_for_review_required": true,
    "isolated_candidate_required": true,
    "incumbent_control_group_required": true,
    "measurable_gain_required": true,
    "guardian_required": true,
    "sentinel_required": true,
    "technology_watch_required": "FRESH",
    "logician_falsification_required": true,
    "production_entrypoint_must_be_unchanged": true,
    "active_self_mutation_forbidden": true,
    "self_promotion_forbidden": true,
    "permission_expansion_forbidden": true,
    "automatic_external_spend_eur": 0,
    "architecture_council_may_confirm_technical_admissibility": true,
    "architecture_council_may_auto_promote": false,
    "explicit_human_promotion_approval_required": true,
    "default_action_without_human_approval": "HOLD_INCUMBENT"
  },
  "platform_component_candidate_review": {
    "enabled": true,
    "pilot_result_required": true,
    "exact_candidate_and_incumbent_revision_required": true,
    "exact_candidate_and_incumbent_artifact_required": true,
    "same_benchmark_contract_required": true,
    "isolated_ephemeral_capsules_required": true,
    "guardian_pre_post_required": true,
    "sentinel_exact_revision_success_required": true,
    "qualification_exact_revision_success_required": true,
    "technology_watch_fresh_required": true,
    "logician_falsification_required": true,
    "permission_non_escalation_required": true,
    "rollback_ready_required": true,
    "measurable_gain_required": true,
    "no_material_regression_required": true,
    "zero_automatic_external_spend_required": true,
    "incumbent_control_group_required": true,
    "production_entrypoint_unchanged_required": true,
    "architecture_council_may_confirm_technical_admissibility": true,
    "architecture_council_may_auto_promote": false,
    "explicit_human_promotion_approval_required": true,
    "default_action_without_human_approval": "HOLD_INCUMBENT",
    "automatic_external_spend_eur": 0
  }
}
