{
  "schema": "chacha.dev/learning-fabric/v1",
  "version": "1.1.0",
  "learners": [
    "core-orchestrator",
    "domain-orchestrators",
    "agent-foundry",
    "branch-foundry",
    "capability-foundry",
    "assembly-orchestrator",
    "acceptance-engine",
    "recovery-orchestrator"
  ],
  "experience_record": {
    "required_fields": [
      "project_id",
      "learner",
      "intent_signature",
      "context_signature",
      "plan_or_strategy",
      "outcome",
      "acceptance_score",
      "cost",
      "latency",
      "resource_usage",
      "failures",
      "corrections",
      "reusable_lessons",
      "evidence"
    ]
  },
  "project_memory_index": {
    "enabled": true,
    "similarity_search": true,
    "retrieves_previous_project_patterns": true,
    "use_before_planning": true,
    "never_copy_project_secret_by_similarity": true
  },
  "learning_cycle": [
    "record-plan",
    "record-outcome",
    "compare-estimate-to-reality",
    "extract-reusable-patterns",
    "compile-rules",
    "update-strategy-priors",
    "retain-counterexamples",
    "promote-qualified-knowledge"
  ],
  "optimization_learning": {
    "branch_blueprint_cost_prediction": true,
    "agent_fit_prediction": true,
    "component_reuse_prediction": true,
    "runtime_resource_prediction": true,
    "acceptance_failure_prediction": true
  },
  "persistence": {
    "authoritative_tier": "NAS",
    "hot_index_tier": "VPS",
    "orchestrator_history_path": "knowledge/orchestrators/{orchestrator}",
    "foundry_history_path": "knowledge/foundries/{foundry}",
    "global_project_index_path": "knowledge/projects/index"
  },
  "forgetting": {
    "preserve_raw_evidence": true,
    "downrank_obsolete_strategies": true,
    "retain_failed_patterns_as_anti_patterns": true
  },
  "learner_registration": {
    "required_for_every_learning_capable_component": true,
    "includes_platform_components": true,
    "includes_embedded_application_agents": true,
    "includes_remote_production_modules": true,
    "unregistered_learning_source_action": "QUARANTINE_DELTA"
  },
  "central_brain_uplink": {
    "enabled": true,
    "sink": "chacha-central-memory",
    "incremental_only": true,
    "full_state_upload_default": false,
    "session_independent": true,
    "reports_when_application_is_used_by_other_users": true,
    "local_offline_spool": true,
    "idempotent_delta_ids": true,
    "monotonic_source_sequence": true
  },
  "remote_production_learning": {
    "continuous_after_release": true,
    "transmit": [
      "changed_knowledge",
      "outcome_metrics",
      "anomaly_signals",
      "correction_results",
      "resource_deltas",
      "version_context",
      "evidence_references"
    ],
    "privacy": {
      "raw_user_content_default": false,
      "secrets_forbidden": true,
      "credentials_forbidden": true,
      "data_minimization_required": true,
      "personal_data_requires_explicit_policy_and_lawful_basis": true
    },
    "security": {
      "https_required": true,
      "per_deployment_authentication": true,
      "signed_delta_required": true,
      "source_revocation_supported": true,
      "replay_protection": true
    }
  },
  "anomaly_feedback_loop": {
    "enabled": true,
    "stages": [
      "observe-production",
      "emit-incremental-delta",
      "correlate-central-memory",
      "classify-anomaly",
      "reproduce-if-possible",
      "generate-correction-candidate",
      "verify",
      "canary-or-sandbox",
      "apply-within-policy",
      "observe-post-correction"
    ],
    "automatic_correction_classes": [
      "rollback-to-known-good",
      "restart-ephemeral-runtime",
      "configuration-within-preapproved-bounds"
    ],
    "approval_gated_classes": [
      "production-code-change",
      "production-data-write",
      "permission-or-secret-change",
      "technology-replacement"
    ],
    "rollback_required": true,
    "evidence_required": true
  }
}
