{
  "schema": "chacha.dev/technology-radar-domain-watch/v2",
  "owner_role": "technology-watch-agent",
  "mode": "ALL_PLATFORM_DOMAINS_AND_CORE",
  "sources_policy": {
    "official_sources_first": true,
    "deterministic_collection_first": true,
    "llm_synthesis_optional": true,
    "paid_research_provider_required": false,
    "platform_core_included": true,
    "source_independence_required": true,
    "vendor_marketing_is_discovery_not_proof": true,
    "executable_evidence_preferred": true,
    "contradictory_evidence_must_be_retained": true
  },
  "watches": {
    "domains": [
      "product",
      "development",
      "data-backend",
      "documentation",
      "ui-layout",
      "graphics",
      "animation",
      "cybersecurity",
      "qa",
      "platform-release",
      "recovery",
      "knowledge-research",
      "translation",
      "publication",
      "assembly"
    ],
    "registries": [
      "dev-hub/config/capability-registry.v1.json",
      "dev-hub/config/provider-adapters.v1.json",
      "dev-hub/config/agent-routing.v1.json",
      "dev-hub/config/domain-orchestration.v1.json",
      "dev-hub/config/provider-economics.v1.json",
      "dev-hub/config/mcp-provider-catalog.v1.json",
      "dev-hub/config/project-factory.v1.json",
      "dev-hub/config/knowledge-fabric.v1.json",
      "dev-hub/config/self-evolution.v1.json"
    ],
    "dimensions": [
      "release",
      "capability",
      "quality",
      "reliability",
      "security-advisory",
      "breaking-change",
      "deprecation",
      "license",
      "pricing",
      "quota",
      "hardware-requirement",
      "api-change",
      "compatibility",
      "benchmark-evidence",
      "maintenance-health",
      "architecture-fit",
      "energy-and-resource-efficiency",
      "autonomy-impact",
      "publisher-reliability",
      "evidence-independence",
      "release-age",
      "blast-radius",
      "technology-debt",
      "source-calibration"
    ]
  },
  "candidate_policy": {
    "discover_uncatalogued_candidates": true,
    "recommendations_only": false,
    "require_official_source": true,
    "require_license_and_cost_class": true,
    "require_domain_mapping": true,
    "require_minimum_fixture_evaluation_before_pilot": true,
    "auto_fixture_evaluation": true,
    "auto_sandbox": true,
    "auto_canary_when_policy_allows": true,
    "require_truth_scoring_before_pilot": true,
    "require_operational_maturity_score": true,
    "require_architecture_fit_score": true,
    "require_publisher_confidence_index": true,
    "require_logician_falsification": true,
    "marketing_only_cannot_promote": true,
    "latest_version_has_no_priority": true,
    "exact_version_required": true
  },
  "output": {
    "recommendation_snapshot": "/opt/chacha-dev/runtime/technology-radar/domain-recommendations.json",
    "health_snapshot": "/opt/chacha-dev/runtime/health/domain-providers.json",
    "maximum_recommendation_age_hours": 24,
    "optimizer_input": "/opt/chacha-dev/runtime/technology-watch/optimizer-input.json",
    "materialization_snapshot": "/opt/chacha-dev/runtime/technology-watch/optimizer-input.json",
    "materialization_snapshot_max_age_minutes": 60
  },
  "governance": {
    "catalog_mutation_allowed": false,
    "provider_status_mutation_allowed": false,
    "auto_install_allowed": true,
    "auto_paid_provider_allowed": false,
    "production_change_allowed": true,
    "human_approval_for_new_provider_pilot": false,
    "security_review_on_security_change": true,
    "auto_install_scope": "sandbox-and-canary-only",
    "production_change_scope": "reversible-policy-qualified-self-upgrade-only",
    "self_upgrade_policy": "dev-hub/config/self-evolution.v1.json"
  },
  "alerts": {
    "immediate": [
      "critical-security-advisory",
      "provider-deprecation",
      "breaking-auth-change",
      "license-incompatibility"
    ],
    "standard": [
      "new-major-release",
      "pricing-change",
      "quota-change",
      "new-capability",
      "better-zero-cost-candidate",
      "new-zero-cost-candidate",
      "major-performance-improvement"
    ]
  },
  "materialization_contract": {
    "consulted_for_every_branch_build": true,
    "consulted_for_every_agent_build": true,
    "consulted_for_every_capability_factory_build": true,
    "current_solution_is_baseline_candidate": true,
    "targeted_refresh_if_snapshot_stale": true,
    "targeted_refresh_if_cost_or_security_signal": true,
    "prefer_zero_external_cost_candidates": true,
    "include_pricing_and_quota_in_candidate_evidence": true,
    "include_resource_requirements_in_candidate_evidence": true
  },
  "truth_assurance": {
    "policy": "dev-hub/config/technology-truth-scoring.v1.json",
    "source_reputation": "dev-hub/config/technology-source-reputation.v1.json",
    "logician_policy": "dev-hub/config/technology-watch-logician.v1.json",
    "evidence_graph_required": true,
    "duplicated_sources_do_not_inflate": true,
    "real_outcome_feedback_required": true,
    "shadow_mode_for_high_blast_radius": true,
    "rollback_must_be_tested_for_adopt": true
  },
  "core_architecture_watch": {
    "enabled": true,
    "inventory": "dev-hub/config/technology-core-watch.v1.json",
    "technology_debt_radar": true,
    "includes_platform_core": true,
    "recommendations_only": true
  }
}
