{
  "schema": "chacha.dev/technology-radar-domain-watch/v2",
  "owner_role": "technology-radar-agent",
  "mode": "ALL_CORE_DOMAINS",
  "sources_policy": {
    "official_sources_first": true,
    "deterministic_collection_first": true,
    "llm_synthesis_optional": true,
    "paid_research_provider_required": false
  },
  "watches": {
    "domains": [
      "product",
      "development",
      "data-backend",
      "documentation",
      "ui-layout",
      "graphics",
      "animation",
      "cybersecurity",
      "qa",
      "platform-release",
      "recovery",
      "knowledge-research"
    ],
    "registries": [
      "dev-hub/config/capability-registry.v1.json",
      "dev-hub/config/provider-adapters.v1.json",
      "dev-hub/config/agent-routing.v1.json",
      "dev-hub/config/domain-orchestration.v1.json",
      "dev-hub/config/provider-economics.v1.json",
      "dev-hub/config/mcp-provider-catalog.v1.json"
    ],
    "dimensions": [
      "release",
      "capability",
      "quality",
      "reliability",
      "security-advisory",
      "breaking-change",
      "deprecation",
      "license",
      "pricing",
      "quota",
      "hardware-requirement",
      "api-change",
      "compatibility",
      "benchmark-evidence",
      "maintenance-health"
    ]
  },
  "candidate_policy": {
    "discover_uncatalogued_candidates": true,
    "recommendations_only": true,
    "require_official_source": true,
    "require_license_and_cost_class": true,
    "require_domain_mapping": true,
    "require_minimum_fixture_evaluation_before_pilot": true
  },
  "output": {
    "recommendation_snapshot": "/opt/chacha-dev/runtime/technology-radar/domain-recommendations.json",
    "health_snapshot": "/opt/chacha-dev/runtime/health/domain-providers.json",
    "maximum_recommendation_age_hours": 168
  },
  "governance": {
    "catalog_mutation_allowed": false,
    "provider_status_mutation_allowed": false,
    "auto_install_allowed": false,
    "auto_paid_provider_allowed": false,
    "production_change_allowed": false,
    "human_approval_for_new_provider_pilot": true,
    "security_review_on_security_change": true
  },
  "alerts": {
    "immediate": [
      "critical-security-advisory",
      "provider-deprecation",
      "breaking-auth-change",
      "license-incompatibility"
    ],
    "standard": [
      "new-major-release",
      "pricing-change",
      "quota-change",
      "new-capability",
      "better-zero-cost-candidate"
    ]
  }
}
