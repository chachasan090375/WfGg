{
  "schema": "chacha.dev/mcp-chrome-devtools-contract/v1",
  "provider_id": "chrome-devtools-mcp",
  "adapter_id": "chrome-devtools-mcp-adapter",
  "decision": "ASSESS",
  "runtime_status": "DESIGNED",
  "purpose": "Isolated Chrome diagnostics for preview/test targets: page structure, console, network and screenshots without repository, workspace or production mutation.",
  "upstream": {
    "package": "chrome-devtools-mcp",
    "design_reference_version": "1.9.0",
    "design_reference_release_date": "2026-09-08",
    "runtime_must_pin_exact_version": true,
    "node_requirement": "LTS",
    "supported_browser": "Google Chrome or Chrome for Testing",
    "technology_radar_tracks_releases": true,
    "official_repository": "https://github.com/ChromeDevTools/chrome-devtools-mcp",
    "official_configuration": "https://github.com/ChromeDevTools/chrome-devtools-mcp/blob/chrome-devtools-mcp-v1.9.0/docs/configuration.md"
  },
  "execution": {
    "pilot_surface": "github-actions-ephemeral",
    "execution": "external",
    "vps_install_allowed_at_design_stage": false,
    "persistent_profile": false,
    "isolated_session_required": true,
    "headless": true,
    "launch_new_isolated_browser_only": true,
    "attach_existing_browser_allowed": false,
    "auto_connect_allowed": false,
    "browser_url_allowed": false,
    "websocket_endpoint_allowed": false,
    "authenticated_user_profile_allowed": false,
    "production_target_allowed": false,
    "accept_insecure_certs": false
  },
  "protocol": {
    "transport": "stdio",
    "dev_hub_input": "chacha.dev/dispatch-envelope/v1",
    "dev_hub_output": "chacha.dev/task-result/v1",
    "provider_result_trust": "UNVERIFIED",
    "verification_broker_required": true,
    "producer_must_not_self_verify": true,
    "dev_hub_preferred_protocol_version": "2026-07-28",
    "upstream_protocol_version": "UNKNOWN_UNTIL_RUNTIME_PROBE",
    "generic_legacy_fallback": false,
    "runtime_protocol_probe_required_before_pilot": true
  },
  "runtime_hardening": {
    "required_flags": [
      "--headless=true",
      "--isolated=true",
      "--no-javascript-evaluation",
      "--no-performance-crux",
      "--no-usage-statistics",
      "--redact-network-headers"
    ],
    "required_environment": {
      "CI": "true",
      "CHROME_DEVTOOLS_MCP_NO_USAGE_STATISTICS": "1",
      "CHROME_DEVTOOLS_MCP_NO_UPDATE_CHECKS": "1"
    },
    "allow_unrestricted_paths": false,
    "filesystem_root_must_be_ephemeral": true,
    "page_id_routing_required": true,
    "source_maps": false,
    "extensions_category": false,
    "experimental_third_party_category": false,
    "pwa_category": false,
    "experimental_devtools": false,
    "experimental_vision": false,
    "memory_debugging": false,
    "experimental_screencast": false
  },
  "tool_policy": {
    "default": "DENY",
    "design_allow": [
      "list_pages",
      "take_snapshot",
      "take_screenshot",
      "list_console_messages",
      "get_console_message",
      "list_network_requests",
      "get_network_request"
    ],
    "explicit_deny": [
      "evaluate_script",
      "click",
      "click_at",
      "drag",
      "fill",
      "fill_form",
      "handle_dialog",
      "hover",
      "press_key",
      "type_text",
      "upload_file",
      "navigate_page",
      "new_page",
      "close_page",
      "resize_page",
      "emulate",
      "lighthouse_audit",
      "performance_start_trace",
      "performance_stop_trace",
      "performance_analyze_insight"
    ],
    "filename_argument_for_read_tools": "DENY",
    "javascript_evaluation": false,
    "file_upload": false,
    "form_submission": false,
    "browser_interaction": false,
    "workspace_write": false,
    "repository_write": false,
    "production_mutation": false
  },
  "network_policy": {
    "test_or_preview_origins_only": true,
    "allowed_url_patterns_required_at_runtime": true,
    "redirect_target_must_be_revalidated_by_adapter": true,
    "network_headers_redacted": true,
    "authorization_header_in_evidence": "REDACT",
    "cookie_header_in_evidence": "REDACT",
    "set_cookie_header_in_evidence": "REDACT",
    "request_or_response_body_capture_default": "DENY",
    "file_url_navigation": false,
    "data_url_navigation": false,
    "javascript_url_navigation": false
  },
  "evidence": {
    "record_package_version": true,
    "record_browser_version": true,
    "record_target_origin": true,
    "record_tool_names": true,
    "record_console_summary": true,
    "record_network_summary": true,
    "record_snapshot_digest": true,
    "record_screenshot_digest": true,
    "credential_values_in_evidence": false,
    "page_secrets_in_evidence": false,
    "screenshots_are_test_artifacts_only": true
  },
  "admission": {
    "automatic_promotion": false,
    "runtime_call_allowed_at_design_stage": false,
    "browser_download_allowed_at_design_stage": false,
    "next_transition": "DESIGNED->CONTRACT_OK",
    "contract_ok_requires": [
      "static-contract-pass",
      "dedicated-adapter-binding",
      "deny-javascript-evaluation",
      "deny-browser-interaction",
      "isolated-ephemeral-pilot-plan",
      "network-redaction-policy-defined",
      "no-existing-browser-attach"
    ],
    "pilot_requires": [
      "runtime-protocol-probe-pass",
      "pinned-package-version",
      "isolated-browser-launch-pass",
      "allowed-url-pattern-enforced",
      "snapshot-pass",
      "console-read-pass",
      "network-read-pass",
      "no-workspace-write-pass"
    ]
  }
}
