{
  "schema": "chacha.dev/platform-readiness/v1",
  "owner_role": "chacha-dev-architect",
  "review_roles": ["platform-cloud-engineer", "security-reviewer", "recovery-engineer"],
  "principles": {
    "readiness_is_evidence_based": true,
    "unknown_is_not_ready": true,
    "contract_readiness_is_not_runtime_readiness": true,
    "runtime_readiness_is_not_production_approval": true,
    "recovery_readiness_requires_fault_injection": true,
    "provider_health_must_be_fresh_and_explicit": true,
    "designed_adapter_is_not_executable": true,
    "storage_pressure_can_block_execution": true,
    "pending_control_transaction_blocks_execution": true,
    "production_readiness_requires_cryptographic_trust": true,
    "private_signing_material_is_never_inspected": true
  },
  "profiles": {
    "contract": {
      "required_checks": [
        "repository-contracts",
        "adapter-static-contract",
        "recovery-drill"
      ]
    },
    "development": {
      "extends": "contract",
      "required_checks": [
        "control-plane-integrity",
        "no-pending-transactions",
        "provider-health",
        "storage-preflight",
        "adapter-runtime-coverage"
      ],
      "required_permissions": ["read", "plan", "workspace-write"],
      "allow_degraded_provider_health": true
    },
    "production": {
      "extends": "development",
      "required_checks": [
        "repository-write-coverage",
        "production-deploy-coverage",
        "signing-runtime",
        "trust-anchor-runtime",
        "production-approval-boundary"
      ],
      "required_permissions": [
        "read",
        "plan",
        "workspace-write",
        "repository-write",
        "preview-deploy",
        "production-deploy"
      ],
      "allow_degraded_provider_health": false
    }
  },
  "repository_paths": {
    "provider_adapters": "dev-hub/config/provider-adapters.v1.json",
    "adapter_contract": "dev-hub/config/adapter-contract.v1.json",
    "capability_registry": "dev-hub/config/capability-registry.v1.json",
    "provider_health_probes": "dev-hub/config/provider-health-probes.v1.json",
    "control_plane_state": "dev-hub/config/control-plane-state.v1.json",
    "transaction_recovery": "dev-hub/config/transaction-recovery.v1.json",
    "recovery_drill": "dev-hub/config/recovery-drill.v1.json",
    "cryptographic_trust": "dev-hub/config/cryptographic-trust.v1.json",
    "run_controller": "dev-hub/config/run-controller.v1.json",
    "orchestration": "dev-hub/config/orchestration-policy.v1.json"
  },
  "engine_paths": {
    "adapter_contract_harness": "dev-hub/bin/adapter-contract-harness.py",
    "control_plane_store": "dev-hub/bin/control-plane-store.py",
    "transaction_recovery": "dev-hub/bin/transaction-recovery.py",
    "recovery_drill": "dev-hub/bin/recovery-drill.py"
  },
  "repository_contracts": {
    "json": [
      "dev-hub/config/adapter-contract.v1.json",
      "dev-hub/config/capability-registry.v1.json",
      "dev-hub/config/control-plane-state.v1.json",
      "dev-hub/config/cryptographic-trust.v1.json",
      "dev-hub/config/execution-scheduler.v1.json",
      "dev-hub/config/orchestration-policy.v1.json",
      "dev-hub/config/project-control.v1.json",
      "dev-hub/config/provider-adapters.v1.json",
      "dev-hub/config/provider-health-probes.v1.json",
      "dev-hub/config/recovery-drill.v1.json",
      "dev-hub/config/run-controller.v1.json",
      "dev-hub/config/transaction-recovery.v1.json"
    ],
    "python": [
      "dev-hub/bin/adapter-contract-harness.py",
      "dev-hub/bin/control-plane-store.py",
      "dev-hub/bin/crypto-trust.py",
      "dev-hub/bin/evidence-collector.py",
      "dev-hub/bin/execution-scheduler.py",
      "dev-hub/bin/lifecycle-engine.py",
      "dev-hub/bin/project-control.py",
      "dev-hub/bin/project-control-api.py",
      "dev-hub/bin/project-control-cli.py",
      "dev-hub/bin/recovery-drill.py",
      "dev-hub/bin/run-controller.py",
      "dev-hub/bin/transaction-recovery.py",
      "dev-hub/bin/verification-broker.py"
    ]
  },
  "provider_health": {
    "schema": "chacha.dev/provider-health-snapshot/v1",
    "baseline_required_providers": ["chacha-dev-architect", "storage-governor"],
    "production_required_providers": ["openssl-ed25519", "github", "nas"],
    "healthy_state": "HEALTHY",
    "degraded_state": "DEGRADED"
  },
  "adapter_runtime": {
    "development_statuses": ["PILOT", "ENABLED", "DEGRADED"],
    "production_statuses": ["ENABLED"]
  },
  "storage": {
    "accepted_statuses": ["OK", "PASS", "READY"],
    "required_for_development": true,
    "required_for_production": true
  },
  "cryptographic_trust": {
    "signing_provider": "openssl-ed25519",
    "signing_adapter": "crypto-trust-adapter",
    "required_anchor_providers": ["nas", "github"],
    "minimum_independent_anchors": 2
  },
  "decision": {
    "ready_value": "YES",
    "not_ready_value": "NO",
    "report_schema": "chacha.dev/platform-readiness-report/v1"
  }
}
