{
  "schema": "chacha.dev/universal-learning/v1",
  "version": "1.2.0",
  "scope": "PLATFORM_GLOBAL",
  "app_specific": false,
  "principle": "Every component that can learn or evolve emits privacy-filtered incremental deltas to the central ChaCha DEV memory, including deployed applications when no human is actively using ChaCha DEV.",
  "source_kinds": [
    "core-orchestrator",
    "domain-orchestrator",
    "foundry",
    "agent",
    "embedded-application-agent",
    "learning-module",
    "runtime-monitor",
    "human-behavior-center"
  ],
  "requirements": {
    "incremental_deltas_only": true,
    "no_full_state_resend_when_unchanged": true,
    "durable_outbox": true,
    "at_least_once_delivery": true,
    "central_deduplication": true,
    "nas_authoritative": true,
    "vps_hot_index": true,
    "global_project_memory_index": true,
    "privacy_filtered": true,
    "raw_user_content_forbidden": true,
    "secrets_forbidden": true,
    "remote_private_key_never_leaves_origin": true,
    "component_lineage_supported": true,
    "exact_lineage_required_for_reuse_feedback": true,
    "missing_lineage_must_not_mutate_reuse_registry": true,
    "production_feedback_idempotent": true,
    "verified_recovery_does_not_auto_adopt": true,
    "verified_component_evaluation_supported": true,
    "absence_of_anomaly_is_not_positive_evidence": true
  },
  "platform_hooks": {
    "central-orchestrator": "automatic",
    "run-controller": "automatic",
    "technology-watch": "automatic",
    "foundries": "covered-by-central-orchestrator-wrapper",
    "runtime-agents": "covered-by-run-controller"
  },
  "remote_app_contract": {
    "producer_required_if_component_can_learn": true,
    "transport": "HTTPS_ED25519_RELAY",
    "producer_identity_per_deployment": true,
    "private_key_origin_local_only": true,
    "background_flush_required": true,
    "learning_continues_without_owner_session": true,
    "lineage_manifest_required_for_reuse_feedback": true,
    "learning_without_lineage_still_allowed": true,
    "verified_evaluation_optional_but_required_for_positive_component_confidence": true
  },
  "anomaly_feedback_loop": {
    "high_or_critical_to_guardian": true,
    "high_guardian_severity": "BLOCK",
    "critical_guardian_severity": "CRITICAL",
    "guardian_target": "central-orchestrator",
    "guardian_directive": "INVESTIGATE_REPLAN_PATCH_AND_VERIFY_PRODUCTION_ANOMALY",
    "production_mutation_directly_by_guardian": false,
    "corrected_action_resubmitted_to_guardian": true
  },
  "economics": {
    "automatic_external_spend_eur": 0
  },
  "production_reuse_feedback": {
    "branch_and_architecture_health_updates": true,
    "all_component_reputation_index": true,
    "high_anomaly_degrades": true,
    "critical_anomaly_quarantines": true,
    "verified_recovery_becomes_candidate_only": true,
    "technology_revalidation_before_reuse": true,
    "acceptance_before_re_adopt": true,
    "direct_application_mutation": false,
    "verified_success_increases_confidence": true,
    "verified_failure_decreases_confidence": true
  },
  "canonical_registry_discovery": true,
  "canonical_registry": "dev-hub/runtime/canonical-component-registry.json",
  "learning_agent_classes": [
    "FULL_AGENT",
    "LIGHTWEIGHT_PROJECT_AGENT",
    "LIGHTWEIGHT_EMBEDDED_AGENT"
  ],
  "manual_source_kinds_are_additive_not_authoritative": true
}
