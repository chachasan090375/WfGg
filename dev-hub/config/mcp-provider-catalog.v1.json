{
  "schema": "chacha.dev/mcp-provider-catalog/v1",
  "protocol": {
    "preferred_version": "2026-07-28",
    "discovery_method": "server/discover",
    "tools_list_method": "tools/list",
    "tools_call_method": "tools/call",
    "remote_transport": "streamable-http",
    "local_transport": "stdio",
    "legacy_sse_for_new_deployments": false,
    "compatibility_policy": "explicit-provider-adapter-only"
  },
  "policy": {
    "default_admission": "DENY",
    "no_secret_values_in_catalog": true,
    "catalog_does_not_enable_runtime": true,
    "adapter_pipeline_required": true,
    "production_change_requires_approval": true,
    "filesystem_root_access_forbidden": true
  },
  "providers": {
    "github-mcp": {
      "display_name": "GitHub MCP / managed connector",
      "category": "control",
      "priority": 1,
      "decision": "ADOPT",
      "runtime_status": "CATALOG_ONLY",
      "integration_mode": "managed-connector",
      "target_capabilities": ["source-control", "code-review", "ci", "artifact-store"],
      "risk_class": "HIGH",
      "write_scope": ["repository-branch", "pull-request", "repository-file"],
      "secret_policy": "EXTERNAL_OAUTH",
      "provider_binding": "github",
      "health_probe": "connector-health",
      "fallback": [],
      "notes": "Use the existing managed GitHub connector first. Repository writes remain branch-scoped and consequential changes require approval gates."
    },
    "cloudflare-mcp": {
      "display_name": "Cloudflare MCP",
      "category": "delivery",
      "priority": 1,
      "decision": "ADOPT",
      "runtime_status": "CATALOG_ONLY",
      "integration_mode": "remote-mcp",
      "target_capabilities": ["cloudflare-control", "cloud-deploy-edge", "cloud-deploy-static", "database-migrate", "cloud-observability", "object-storage"],
      "risk_class": "CRITICAL",
      "write_scope": ["preview-deploy", "worker-config", "d1-migration", "r2-object"],
      "secret_policy": "EXTERNAL_OAUTH",
      "provider_binding": "cloudflare",
      "health_probe": "mcp-server-discover-tools-list-and-account-read",
      "fallback": ["wrangler", "cloudflare-pages", "github-actions"],
      "notes": "Primary Cloudflare control candidate. Production deployment, DNS, destructive D1/R2 actions and secret changes must remain separately gated."
    },
    "playwright-mcp": {
      "display_name": "Playwright MCP",
      "category": "verification",
      "priority": 1,
      "decision": "ASSESS",
      "runtime_status": "CATALOG_ONLY",
      "integration_mode": "local-mcp",
      "target_capabilities": ["browser-automation", "e2e-test-web", "ui-recette"],
      "risk_class": "MEDIUM",
      "write_scope": ["test-artifacts"],
      "secret_policy": "REFERENCE_ONLY",
      "provider_binding": "playwright",
      "health_probe": "mcp-server-discover-tools-list-and-browser-launch",
      "fallback": ["playwright"],
      "notes": "Complements the existing Playwright project runner. Initial MCP admission should be non-production and test-account only."
    },
    "chrome-devtools-mcp": {
      "display_name": "Chrome DevTools MCP",
      "category": "observability",
      "priority": 1,
      "decision": "ASSESS",
      "runtime_status": "CATALOG_ONLY",
      "integration_mode": "local-mcp",
      "target_capabilities": ["browser-diagnostics", "console-inspection", "network-inspection", "performance-inspection"],
      "risk_class": "MEDIUM",
      "write_scope": ["browser-session"],
      "secret_policy": "REFERENCE_ONLY",
      "provider_binding": null,
      "health_probe": "mcp-server-discover-tools-list-and-browser-attach",
      "fallback": ["playwright-mcp", "playwright"],
      "notes": "Diagnostic complement to Playwright; not a deployment provider and not allowed to mutate production state."
    },
    "filesystem-mcp": {
      "display_name": "Filesystem MCP",
      "category": "storage",
      "priority": 2,
      "decision": "ASSESS",
      "runtime_status": "CATALOG_ONLY",
      "integration_mode": "local-mcp",
      "target_capabilities": ["workspace-files", "adapter-files", "evidence-files"],
      "risk_class": "CRITICAL",
      "write_scope": ["approved-workspace-only"],
      "allowed_roots": [
        "/opt/chacha-dev/workspaces",
        "/opt/chacha-dev/adapters",
        "/opt/chacha-dev/evidence"
      ],
      "forbidden_roots": ["/", "/etc", "/root", "/home", "/var/lib", "/opt/chacha-dev/secrets"],
      "secret_policy": "NONE",
      "provider_binding": null,
      "health_probe": "mcp-server-discover-tools-list-and-approved-root-read",
      "fallback": [],
      "notes": "Never expose filesystem root. Start read-only; any write permission must be explicit per approved root and pass Storage Governor."
    },
    "context7-mcp": {
      "display_name": "Context7 MCP",
      "category": "knowledge",
      "priority": 2,
      "decision": "ADOPT",
      "runtime_status": "DESIGNED",
      "integration_mode": "remote-mcp",
      "target_capabilities": ["library-docs", "framework-docs"],
      "risk_class": "LOW",
      "write_scope": [],
      "secret_policy": "REFERENCE_ONLY",
      "provider_binding": "context7-mcp",
      "health_probe": "mcp-server-discover-and-tools-list",
      "fallback": ["mdn-mcp"],
      "notes": "Already represented in DEV HUB V5. Keep read-only and use provider-specific official docs when they are stronger."
    },
    "sentry-mcp": {
      "display_name": "Sentry MCP",
      "category": "observability",
      "priority": 2,
      "decision": "ASSESS",
      "runtime_status": "CATALOG_ONLY",
      "integration_mode": "remote-mcp",
      "target_capabilities": ["incident-observability", "stacktrace-analysis", "release-health"],
      "risk_class": "HIGH",
      "write_scope": [],
      "secret_policy": "EXTERNAL_OAUTH",
      "provider_binding": null,
      "health_probe": "mcp-server-discover-tools-list-and-project-read",
      "fallback": ["cloudflare-mcp"],
      "notes": "Read-only incident analysis first. Issue mutation or release management requires a later contract."
    },
    "exa-mcp": {
      "display_name": "Exa MCP",
      "category": "knowledge",
      "priority": 3,
      "decision": "WATCH",
      "runtime_status": "CATALOG_ONLY",
      "integration_mode": "remote-mcp",
      "target_capabilities": ["web-research", "code-example-search"],
      "risk_class": "LOW",
      "write_scope": [],
      "secret_policy": "REFERENCE_ONLY",
      "provider_binding": null,
      "health_probe": "mcp-server-discover-tools-list-and-search",
      "fallback": ["technology-radar", "github"],
      "notes": "Useful for recent technical examples and obscure bug research; not required for the first MCP wave."
    },
    "firecrawl-mcp": {
      "display_name": "Firecrawl MCP",
      "category": "knowledge",
      "priority": 3,
      "decision": "WATCH",
      "runtime_status": "CATALOG_ONLY",
      "integration_mode": "remote-mcp",
      "target_capabilities": ["web-extraction", "documentation-ingestion", "structured-crawl"],
      "risk_class": "MEDIUM",
      "write_scope": [],
      "secret_policy": "REFERENCE_ONLY",
      "provider_binding": null,
      "health_probe": "mcp-server-discover-tools-list-and-scrape",
      "fallback": ["exa-mcp"],
      "notes": "Introduce only when a project needs systematic documentation or website ingestion."
    },
    "figma-mcp": {
      "display_name": "Figma MCP",
      "category": "design",
      "priority": 3,
      "decision": "WATCH",
      "runtime_status": "CATALOG_ONLY",
      "integration_mode": "remote-mcp",
      "target_capabilities": ["design-inspection", "design-token-read", "design-to-code"],
      "risk_class": "MEDIUM",
      "write_scope": [],
      "secret_policy": "EXTERNAL_OAUTH",
      "provider_binding": null,
      "health_probe": "mcp-server-discover-tools-list-and-file-read",
      "fallback": [],
      "notes": "Useful when Figma becomes an authoritative design source; not needed for current WfGg delivery."
    },
    "vercel-mcp": {
      "display_name": "Vercel MCP",
      "category": "delivery",
      "priority": 3,
      "decision": "DEFER",
      "runtime_status": "CATALOG_ONLY",
      "integration_mode": "remote-mcp",
      "target_capabilities": ["vercel-deploy", "vercel-build-logs"],
      "risk_class": "HIGH",
      "write_scope": [],
      "secret_policy": "EXTERNAL_OAUTH",
      "provider_binding": null,
      "health_probe": null,
      "fallback": [],
      "notes": "Deferred because WfGg currently deploys on Cloudflare. Reassess only for a project that explicitly adopts Vercel."
    },
    "supabase-mcp": {
      "display_name": "Supabase MCP",
      "category": "data",
      "priority": 3,
      "decision": "DEFER",
      "runtime_status": "CATALOG_ONLY",
      "integration_mode": "remote-mcp",
      "target_capabilities": ["postgres-schema", "sql-migration", "rls-policy"],
      "risk_class": "CRITICAL",
      "write_scope": [],
      "secret_policy": "EXTERNAL_OAUTH",
      "provider_binding": null,
      "health_probe": null,
      "fallback": [],
      "notes": "Deferred because current WfGg data services use Cloudflare D1. Reassess if a future project chooses PostgreSQL/Supabase."
    }
  }
}
