{
  "schema": "chacha.dev/orchestration-policy/v1",
  "orchestrator": "chacha-dev-architect",
  "references": {
    "agent_routing": "dev-hub/config/agent-routing.v1.json",
    "capability_registry": "dev-hub/config/capability-registry.v1.json",
    "lifecycle": "dev-hub/config/lifecycle.v1.json",
    "quality_gates": "dev-hub/config/quality-gates.v1.json",
    "evidence_catalog": "dev-hub/config/evidence-catalog.v1.json",
    "execution_scheduler": "dev-hub/config/execution-scheduler.v1.json",
    "run_controller": "dev-hub/config/run-controller.v1.json",
    "provider_adapters": "dev-hub/config/provider-adapters.v1.json",
    "verification_broker": "dev-hub/config/verification-broker.v1.json",
    "adapter_contract": "dev-hub/config/adapter-contract.v1.json",
    "control_plane_state": "dev-hub/config/control-plane-state.v1.json",
    "cryptographic_trust": "dev-hub/config/cryptographic-trust.v1.json",
    "project_control": "dev-hub/config/project-control.v1.json"
  },
  "principles": {
    "least_privilege": true,
    "specialist_agents_do_not_self_promote": true,
    "evidence_required_before_success_claim": true,
    "production_mutation_never_implicit": true,
    "tool_provider_is_replaceable": true,
    "orchestrator_records_decisions": true,
    "scheduler_does_not_execute_implicitly": true,
    "provider_failover_is_policy_controlled": true,
    "dispatch_is_separate_from_planning": true,
    "run_controller_cannot_self_verify": true,
    "unregistered_adapter_cannot_execute": true,
    "verification_is_separate_from_execution": true,
    "adapter_enablement_requires_contract_evidence": true,
    "human_verification_is_never_faked_or_automated": true,
    "current_project_state_has_one_control_plane_projection": true,
    "all_consequential_state_changes_are_audited": true,
    "audit_history_is_append_only_and_hash_chained": true,
    "control_plane_state_is_rebuildable_from_audit_history": true,
    "security_reviewer_owns_cryptographic_policy": true,
    "private_signing_material_is_not_accessible_to_orchestrator": true,
    "release_boundaries_require_valid_digital_signature": true,
    "key_lifecycle_requires_explicit_human_approval": true,
    "release_trust_requires_external_anchor_quorum": true,
    "project_control_is_the_unified_operator_surface": true,
    "project_control_has_no_network_listener_by_default": true,
    "control_plane_projection_is_canonical_for_project_status": true,
    "lifecycle_promotion_is_transactional": true,
    "lifecycle_engine_checks_but_does_not_own_persistent_stage": true,
    "pending_control_transaction_blocks_further_promotion": true
  },
  "permissions": {
    "read": {"approval": "none"},
    "plan": {"approval": "none"},
    "workspace-write": {"approval": "policy"},
    "repository-write": {"approval": "policy"},
    "preview-deploy": {"approval": "policy"},
    "production-deploy": {"approval": "explicit-human"},
    "production-data-write": {"approval": "explicit-human"},
    "secret-change": {"approval": "explicit-human"},
    "destructive-operation": {"approval": "explicit-human"},
    "technology-replacement": {"approval": "explicit-human"},
    "signing-key-activation": {"approval": "explicit-human"},
    "signing-key-rotation": {"approval": "explicit-human"},
    "signing-key-revocation": {"approval": "explicit-human"}
  },
  "stages": {
    "IDEA": {"lead_roles": ["product-domain", "orchestrator"], "allowed_permissions": ["read", "plan"], "outputs": ["project-intent"]},
    "DESIGN": {"lead_roles": ["orchestrator", "platform", "security", "data", "frontend", "backend-api"], "allowed_permissions": ["read", "plan"], "outputs": ["project-plan", "manifest-v3", "architecture-decisions", "capability-resolution"]},
    "READY": {"lead_roles": ["orchestrator", "platform", "security"], "allowed_permissions": ["read", "plan", "workspace-write"], "outputs": ["workspace-health", "storage-preflight", "dependency-resolution", "cryptographic-trust-readiness"]},
    "BUILD": {"lead_roles": ["frontend", "backend-api", "data", "platform", "documentation"], "allowed_permissions": ["read", "plan", "workspace-write", "repository-write"], "outputs": ["change-set", "build-result", "static-check"]},
    "VERIFY": {"lead_roles": ["testing", "security", "performance", "orchestrator"], "allowed_permissions": ["read", "plan", "workspace-write", "repository-write"], "outputs": ["test-result", "security-scan", "ci-result", "trust-verification"]},
    "PREVIEW": {"lead_roles": ["release", "testing", "sre-observability", "security"], "allowed_permissions": ["read", "plan", "workspace-write", "repository-write", "preview-deploy"], "outputs": ["preview-validation", "e2e-result", "smoke-result", "rollback-plan", "signed-release-checkpoint-candidate"]},
    "RELEASE": {"lead_roles": ["release", "orchestrator", "recovery", "security"], "allowed_permissions": ["read", "plan", "repository-write", "production-deploy"], "outputs": ["production-deployment-receipt", "signed-release-checkpoint", "external-anchor-receipts"]},
    "OPERATE": {"lead_roles": ["operations", "sre-observability", "recovery", "technology-radar", "security"], "allowed_permissions": ["read", "plan", "workspace-write", "repository-write"], "outputs": ["production-health", "observability-health", "incident-records", "technology-watch", "routine-signed-checkpoints"]},
    "RETIRE": {"lead_roles": ["orchestrator", "operations", "recovery", "data", "security"], "allowed_permissions": ["read", "plan", "repository-write", "destructive-operation"], "outputs": ["retirement-record", "archive-proof", "data-disposition", "signed-retirement-checkpoint"]}
  },
  "execution_rules": {
    "max_parallel_write_agents_per_project": 1,
    "parallel_read_agents_allowed": true,
    "repository_write_requires_clean_or_declared_workspace": true,
    "heavy_operation_requires_storage_preflight": true,
    "provider_health_check_before_execution": true,
    "failed_specialist_task_returns_to_orchestrator": true,
    "fallback_provider_must_be_recorded": true,
    "unverified_output_cannot_satisfy_lifecycle_evidence": true,
    "unknown_provider_health_blocks_execution": true,
    "scheduler_plan_requires_explicit_dispatch": true,
    "dispatch_requires_registered_adapter": true,
    "write_dispatch_requires_project_lock": true,
    "run_controller_output_requires_independent_verification": true,
    "production_dispatch_rechecks_human_approval": true,
    "verification_broker_must_not_be_task_producer": true,
    "human_verification_requires_real_human_actor": true,
    "adapter_status_designed_cannot_execute": true,
    "adapter_promotion_is_never_automatic": true,
    "state_mutation_requires_audit_event": true,
    "audit_event_sequence_must_be_contiguous": true,
    "audit_event_hash_chain_must_verify": true,
    "projection_must_match_journal_head": true,
    "release_and_retirement_boundaries_require_checkpoint": true,
    "release_and_retirement_checkpoints_require_ed25519_signature": true,
    "signing_key_private_material_must_not_be_logged_or_stored_in_git": true,
    "signing_key_activation_rotation_revocation_require_human_approval": true,
    "release_requires_two_independent_trust_anchors": true,
    "cryptographic_policy_changes_require_security_review": true,
    "operator_actions_should_enter_through_project_control": true,
    "project_control_dispatch_requires_explicit_execute_flag": true,
    "project_control_must_not_bypass_underlying_engine_policies": true,
    "lifecycle_advance_requires_project_control_transaction": true,
    "transaction_rechecks_control_plane_integrity_before_and_after_commit": true,
    "verified_evidence_ingest_is_audit_linked": true,
    "generic_control_event_cannot_mutate_protected_lifecycle_or_approval_state": true
  }
}
