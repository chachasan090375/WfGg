{
  "schema": "chacha.dev/direct-operator-policy/v1",
  "version": "1.5.0",
  "component": "direct-operator-service",
  "bind": "127.0.0.1",
  "port": 8792,
  "runtime_root": "/opt/chacha-dev/runtime/direct-operator",
  "ui_root": "dev-hub/direct-operator-ui",
  "max_request_bytes": 65536,
  "default_project": "chacha-dev-platform",
  "authentication": {
    "mode": "TAILSCALE_SERVE_IDENTITY",
    "login_header": "Tailscale-User-Login",
    "authorized_users_file": "/opt/chacha-dev/runtime/secrets/direct-operator-authorized-users.json",
    "fail_closed_if_identity_missing": true,
    "backend_must_bind_loopback": true
  },
  "transport": {
    "public_funnel_forbidden": true,
    "tailscale_serve_private_only": true,
    "tailscale_https_port": 8443,
    "expected_url": "https://chachavps.tail3ab05a.ts.net:8443"
  },
  "translator": {
    "id": "functional-translator-satellite",
    "script": "dev-hub/bin/functional-translator-agent.py",
    "execution_authority": false,
    "architecture_authority": false,
    "raw_text_preserved": true,
    "contract": "dev-hub/config/functional-translator-satellite.v1.json",
    "fleet_membership": "EXCLUDED_EDGE_SATELLITE"
  },
  "central_controller": "dev-hub/bin/central-interface-controller.py",
  "emergency_controller": "dev-hub/bin/emergency-stop-controller.py",
  "invariants": {
    "chatgpt_not_in_direct_path": true,
    "direct_operator_has_no_technical_decision_authority": true,
    "direct_operator_has_no_direct_mutation": true,
    "central_orchestrator_required": true,
    "guardian_and_platform_governance_preserved": true,
    "automatic_external_spend_eur": 0,
    "persistent_progress_reporting": true,
    "remote_android_live_shell_config": true,
    "live_ui_runtime_channel": true,
    "live_ui_fallback_to_bundled_source": true,
    "native_update_private_origin_only": true,
    "conversation_interface_required": true,
    "conversation_interface_has_no_decision_authority": true
  },
  "progress_policy": "dev-hub/config/progress-reporting.v1.json",
  "android_live_shell_config": "dev-hub/config/android-live-shell.v1.json",
  "live_ui_root": "/opt/chacha-dev/runtime/live-ui/current/ui",
  "live_app_config": "/opt/chacha-dev/runtime/live-ui/current/app-config.json",
  "android_native_update_policy": "dev-hub/config/android-native-update.v1.json",
  "native_update_manifest": "/opt/chacha-dev/runtime/native-update/current/manifest.json",
  "native_update_packages_root": "/opt/chacha-dev/runtime/native-update/current/packages",
  "conversation": {
    "id": "conversation-interface-agent",
    "script": "dev-hub/bin/conversation-interface-agent.py",
    "contract": "dev-hub/config/conversation-interface-agent.v1.json",
    "decision_authority": false,
    "execution_authority": false,
    "central_authority_preserved": true
  }
}
