{
  "schema": "chacha.dev/direct-operator-policy/v1",
  "version": "1.8.0",
  "component": "direct-operator-service",
  "bind": "127.0.0.1",
  "port": 8792,
  "runtime_root": "/opt/chacha-dev/runtime/direct-operator",
  "ui_root": "dev-hub/direct-operator-ui",
  "max_request_bytes": 65536,
  "default_project": "chacha-dev-platform",
  "authentication": {
    "mode": "TAILSCALE_SERVE_IDENTITY",
    "login_header": "Tailscale-User-Login",
    "authorized_users_file": "/opt/chacha-dev/runtime/secrets/direct-operator-authorized-users.json",
    "fail_closed_if_identity_missing": true,
    "backend_must_bind_loopback": true
  },
  "transport": {
    "public_funnel_forbidden": true,
    "tailscale_serve_private_only": true,
    "tailscale_https_port": 8443,
    "expected_url": "https://chachavps.tail3ab05a.ts.net:8443"
  },
  "translator": {
    "id": "functional-translator-satellite",
    "script": "dev-hub/bin/functional-translator-agent.py",
    "execution_authority": false,
    "architecture_authority": false,
    "raw_text_preserved": true,
    "contract": "dev-hub/config/functional-translator-satellite.v1.json",
    "fleet_membership": "EXCLUDED_EDGE_SATELLITE"
  },
  "central_controller": "dev-hub/bin/central-interface-controller.py",
  "emergency_controller": "dev-hub/bin/emergency-stop-controller.py",
  "invariants": {
    "chatgpt_not_in_direct_path": true,
    "direct_operator_has_no_technical_decision_authority": true,
    "direct_operator_has_no_direct_mutation": true,
    "central_orchestrator_required": "BUILD_CHANNEL_ONLY",
    "conversation_channel_has_no_direct_mutation": true,
    "manual_channel_switch_is_authoritative": true,
    "guardian_and_platform_governance_preserved": true,
    "automatic_external_spend_eur": 0,
    "persistent_progress_reporting": true,
    "remote_android_live_shell_config": true,
    "live_ui_runtime_channel": true,
    "live_ui_fallback_to_bundled_source": true,
    "native_update_private_origin_only": true,
    "conversation_interface_required": true,
    "conversation_interface_has_no_decision_authority": true,
    "transient_execution_project_never_becomes_session_project": true,
    "plan_ready_is_not_terminal": true,
    "accepted_prompt_is_removed_from_editor": true,
    "dialogue_model_may_only_rephrase_human_message": true,
    "dialogue_provider_requires_zero_cost_attestation": true,
    "voice_gateway_has_no_execution_authority": true,
    "voice_gateway_has_no_build_auto_switch": true,
    "operator_structural_directive_capture_before_downstream": true,
    "verified_existing_candidate_bypasses_new_domain_factory_bootstrap": true
  },
  "progress_policy": "dev-hub/config/progress-reporting.v1.json",
  "android_live_shell_config": "dev-hub/config/android-live-shell.v1.json",
  "live_ui_root": "/opt/chacha-dev/runtime/live-ui/current/ui",
  "live_app_config": "/opt/chacha-dev/runtime/live-ui/current/app-config.json",
  "android_native_update_policy": "dev-hub/config/android-native-update.v1.json",
  "native_update_manifest": "/opt/chacha-dev/runtime/native-update/current/manifest.json",
  "native_update_packages_root": "/opt/chacha-dev/runtime/native-update/current/packages",
  "conversation": {
    "id": "conversation-interface-agent",
    "script": "dev-hub/bin/conversation-interface-agent.py",
    "contract": "dev-hub/config/conversation-interface-agent.v1.json",
    "decision_authority": false,
    "execution_authority": false,
    "central_authority_preserved": true
  },
  "auto_continue": {
    "enabled": true,
    "max_steps": 24,
    "non_terminal_statuses": [
      "PLAN_READY",
      "CONTINUED",
      "READY"
    ],
    "stop_on_human_approval": true,
    "stop_on_await_user_action": true
  },
  "human_conversation": {
    "policy": "dev-hub/config/human-conversation.v1.json",
    "context_engine": "dev-hub/bin/human-context-engine.py",
    "profile_storage": "PRIVATE_RUNTIME_PER_OPERATOR",
    "timeline_storage": "PRIVATE_RUNTIME_PER_OPERATOR",
    "profile_inference": "FORBIDDEN",
    "technical_decision_authority": false,
    "automatic_external_spend_eur": 0
  },
  "dialogue_orchestrator": {
    "id": "dialogue-orchestrator",
    "script": "dev-hub/bin/dialogue-orchestrator.py",
    "policy": "dev-hub/config/dialogue-orchestrator.v1.json",
    "zero_cost_attestation": "/opt/chacha-dev/runtime/provider-economics/agy-conversation-zero-cost.json",
    "decision_authority": false,
    "execution_authority": false,
    "mutation_authority": false,
    "fallback_is_deterministic": true,
    "automatic_external_spend_eur": 0
  },
  "human_behavior_center": {
    "agent_id": "human-behavior-center",
    "policy": "dev-hub/config/human-behavior-center.v1.json",
    "script": "dev-hub/bin/human-behavior-center.py",
    "persona_dir": "/opt/chacha-dev/runtime/knowledge/human-behavior/personas",
    "evidence_db": "/opt/chacha-dev/runtime/knowledge/human-behavior/evidence.db",
    "decision_authority": false,
    "execution_authority": false,
    "automatic_external_spend_eur": 0
  },
  "dual_channel": {
    "policy": "dev-hub/config/dual-channel.v1.json",
    "router": "dev-hub/bin/conversation-channel-router.py",
    "advisory_bus": "dev-hub/bin/conversation-advisory-bus.py",
    "research_broker": "dev-hub/bin/research-broker.py",
    "reasoner": "dev-hub/bin/conversation-reasoner.py",
    "reasoner_policy": "dev-hub/config/conversation-reasoner.v1.json",
    "zero_cost_attestation": "/opt/chacha-dev/runtime/provider-economics/agy-conversation-zero-cost.json",
    "central_memory_snapshot": "/opt/chacha-dev/runtime/knowledge/central-memory-assimilation.json",
    "technology_watch_snapshot": "/opt/chacha-dev/runtime/technology-watch/optimizer-input.json",
    "default_api_channel": "BUILD",
    "ui_default_channel": "CONVERSATION",
    "manual_switch_authoritative": true,
    "conversation_mutation_authority": false,
    "automatic_external_spend_eur": 0,
    "central_orchestrator_required": "BUILD_CHANNEL_ONLY",
    "emergency_stop_scope": "GLOBAL_ALL_CHANNELS",
    "conversation_stop_routed_to_control_plane": true
  },
  "voice_gateway": {
    "policy": "dev-hub/config/voice-gateway.v1.json",
    "native_shell_protocol_version": 2,
    "progressive_enhancement": true,
    "conversation_channel_only": true,
    "build_auto_switch": false,
    "raw_audio_persistence": false,
    "automatic_external_spend_eur": 0
  },
  "operator_directives": {
    "policy": "dev-hub/config/operator-directives.v1.json",
    "intake": "/opt/chacha-dev/runtime/governance/operator-directives/intake.jsonl",
    "capture_before_downstream_execution": true,
    "structural_candidate_not_active_until_verified": true,
    "automatic_external_spend_eur": 0
  }
}
