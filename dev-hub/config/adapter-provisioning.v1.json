{
  "schema": "chacha.dev/adapter-provisioning/v1",
  "principles": {
    "provisioning_precedes_local_pilot": true,
    "explicit_apply_required": true,
    "version_directory_is_immutable": true,
    "source_and_installed_digest_must_match": true,
    "current_symlink_is_updated_atomically": true,
    "provisioning_never_changes_adapter_status": true,
    "provisioning_receipt_is_required": true,
    "private_secrets_are_never_written_to_receipts": true,
    "runtime_probe_must_be_non_destructive": true
  },
  "target_root": "/opt/chacha-dev/adapters",
  "receipt_root": "/opt/chacha-dev/runtime/adapter-provisioning",
  "sandbox_root_override_allowed": true,
  "probe_timeout_seconds": 10,
  "adapters": {
    "http-smoke-adapter": {
      "source": "dev-hub/adapters/http-smoke-adapter.py",
      "namespace": "http-smoke",
      "version": "1.0.0",
      "executable_name": "http-smoke-adapter",
      "mode": "0755",
      "current_link_name": "current",
      "probe": {
        "input": {
          "schema": "chacha.dev/dispatch-envelope/v1",
          "project": "adapter-provisioning-probe",
          "task": {
            "id": "probe",
            "permission": "read"
          },
          "bindings": [],
          "metadata": {}
        },
        "expected_schema": "chacha.dev/task-result/v1",
        "expected_status": "BLOCKED",
        "expected_producer": "http-smoke-adapter",
        "expected_verification_status": "UNVERIFIED"
      }
    },
    "radar-runtime-adapter": {
      "source": "dev-hub/adapters/radar-runtime-adapter.py",
      "namespace": "radar-runtime",
      "version": "1.5.5",
      "executable_name": "radar-runtime-adapter",
      "mode": "0755",
      "current_link_name": "current",
      "probe": {
        "input": {
          "schema": "chacha.dev/dispatch-envelope/v1",
          "project": "wfgg-radar",
          "transition": "OPERATE->OPERATE",
          "run_id": "radar-runtime-provisioning-probe",
          "wave": 1,
          "task": {
            "id": "radar-runtime:status",
            "kind": "runtime-status",
            "description": "Provisioning probe for WfGg Radar runtime adapter.",
            "owner_role": "sre-observability",
            "permission": "read",
            "outputs": [
              {
                "type": "artifact",
                "id": "radar-runtime-status"
              }
            ],
            "verification": {
              "mode": "machine",
              "self_certification_allowed": false,
              "required_evidence": [
                "source",
                "timestamp",
                "digest"
              ]
            }
          },
          "bindings": [
            {
              "capability": "radar-runtime-inspect",
              "provider": "radar-vps-runtime",
              "adapter": "radar-runtime-adapter",
              "fallback_used": false,
              "health_state": "HEALTHY"
            }
          ],
          "policy_context": {
            "resource_class": "light",
            "requires_storage_preflight": false,
            "human_approval_required": false,
            "approval_id": null,
            "timeout_seconds": 20
          },
          "workspace": null,
          "metadata": {
            "radar_runtime": {
              "action": "status"
            }
          }
        },
        "expected_schema": "chacha.dev/task-result/v1",
        "expected_status": "OK",
        "expected_producer": "radar-runtime-adapter",
        "expected_verification_status": "UNVERIFIED"
      }
    },
    "architecture-specialist-adapter": {
      "source": "dev-hub/adapters/architecture-specialist-adapter.py",
      "namespace": "architecture-specialist",
      "version": "1.0.4",
      "executable_name": "architecture-specialist-adapter",
      "mode": "0755",
      "current_link_name": "current",
      "probe": {
        "input": {
          "schema": "chacha.dev/dispatch-envelope/v1",
          "project": "architecture-specialist-provisioning-probe",
          "transition": "DESIGN->DESIGN",
          "run_id": "architecture-specialist-provisioning-probe",
          "wave": 1,
          "task": {
            "id": "architecture-specialist:status",
            "kind": "runtime-status",
            "description": "Provisioning status probe for ChaCha DEV Architecture Specialist Runtime.",
            "owner_role": "sre-observability-engineer",
            "permission": "read",
            "outputs": [
              {
                "type": "artifact",
                "id": "architecture-specialist-runtime-status"
              }
            ],
            "verification": {
              "mode": "machine",
              "self_certification_allowed": false,
              "required_evidence": [
                "source",
                "timestamp",
                "digest"
              ]
            }
          },
          "bindings": [
            {
              "capability": "architecture-audit",
              "provider": "chacha-dev-architect",
              "adapter": "architecture-specialist-adapter",
              "fallback_used": false,
              "health_state": "HEALTHY"
            }
          ],
          "policy_context": {
            "resource_class": "light",
            "requires_storage_preflight": false,
            "human_approval_required": false,
            "approval_id": null,
            "timeout_seconds": 30
          },
          "workspace": null,
          "metadata": {
            "architecture_specialist": {
              "action": "status"
            }
          }
        },
        "expected_schema": "chacha.dev/task-result/v1",
        "expected_status": "OK",
        "expected_producer": "architecture-specialist-adapter",
        "expected_verification_status": "UNVERIFIED"
      }
    },
    "collector-knowledge-adapter": {
      "source": "dev-hub/adapters/collector-knowledge-adapter.py",
      "namespace": "collector-knowledge",
      "version": "1.0.0",
      "executable_name": "collector-knowledge-adapter",
      "mode": "0755",
      "current_link_name": "current",
      "probe": {
        "input": {
          "schema": "chacha.dev/dispatch-envelope/v1",
          "project": "wfgg-radar",
          "transition": "OPERATE->OPERATE",
          "run_id": "collector-knowledge-provisioning-probe",
          "wave": 1,
          "task": {
            "id": "collector-knowledge:status",
            "kind": "runtime-status",
            "description": "Provisioning probe for WfGg Collector Knowledge runtime adapter.",
            "owner_role": "sre-observability",
            "permission": "read",
            "outputs": [
              {
                "type": "artifact",
                "id": "collector-knowledge-status"
              }
            ],
            "verification": {
              "mode": "machine",
              "self_certification_allowed": false,
              "required_evidence": [
                "source",
                "timestamp",
                "digest"
              ]
            }
          },
          "bindings": [
            {
              "capability": "collector-knowledge-inspect",
              "provider": "collector-knowledge-runtime",
              "adapter": "collector-knowledge-adapter",
              "fallback_used": false,
              "health_state": "HEALTHY"
            }
          ],
          "policy_context": {
            "resource_class": "light",
            "requires_storage_preflight": false,
            "human_approval_required": false,
            "approval_id": null,
            "timeout_seconds": 20
          },
          "workspace": null,
          "metadata": {
            "collector_knowledge": {
              "action": "status"
            }
          }
        },
        "expected_schema": "chacha.dev/task-result/v1",
        "expected_producer": "collector-knowledge-adapter",
        "expected_verification_status": "UNVERIFIED",
        "expected_statuses": [
          "OK",
          "BLOCKED"
        ],
        "health_decision_deferred_to_provider_probe": true
      }
    },
    "cloudflare-pages-production-adapter": {
      "source": "dev-hub/adapters/cloudflare-pages-production-adapter.py",
      "namespace": "cloudflare-pages-production",
      "version": "1.0.1",
      "executable_name": "cloudflare-pages-production-adapter",
      "mode": "0755",
      "current_link_name": "current",
      "probe": {
        "input": {
          "schema": "chacha.dev/dispatch-envelope/v1",
          "project": "cloudflare-pages-production-provisioning-probe",
          "transition": "RELEASE->RELEASE",
          "run_id": "cloudflare-pages-production-provisioning-probe",
          "wave": 1,
          "task": {
            "id": "cloudflare-pages-production:contract-status",
            "kind": "runtime-status",
            "description": "Non-mutating provisioning probe for the Cloudflare Pages production adapter.",
            "owner_role": "platform-cloud-engineer",
            "permission": "read",
            "outputs": [
              {
                "type": "artifact",
                "id": "cloudflare-pages-production-contract"
              }
            ],
            "verification": {
              "mode": "machine",
              "self_certification_allowed": false,
              "required_evidence": [
                "source",
                "timestamp",
                "digest"
              ]
            }
          },
          "bindings": [
            {
              "capability": "cloud-deploy-static",
              "provider": "cloudflare-pages-production",
              "adapter": "cloudflare-pages-production-adapter",
              "fallback_used": false,
              "health_state": "UNKNOWN"
            }
          ],
          "policy_context": {
            "resource_class": "light",
            "requires_storage_preflight": false,
            "human_approval_required": false,
            "approval_id": null,
            "timeout_seconds": 20
          },
          "workspace": null,
          "metadata": {
            "cloudflare_pages_production": {
              "action": "contract-status"
            }
          }
        },
        "expected_schema": "chacha.dev/task-result/v1",
        "expected_status": "OK",
        "expected_producer": "cloudflare-pages-production-adapter",
        "expected_verification_status": "UNVERIFIED"
      }
    },
    "branch-foundry-source-integrator-v1": {
      "source": "dev-hub/adapters/platform-component-branch-foundry-source-integrator.py",
      "namespace": "platform-component/branch-foundry-source-integrator",
      "version": "1.0.1",
      "executable_name": "branch-foundry-source-integrator",
      "mode": "0755",
      "current_link_name": "current",
      "probe": {
        "argv": [
          "apply"
        ],
        "input": {},
        "expected_exit_code": 2,
        "expected_schema": "chacha.dev/platform-component-source-integration-adapter-result/v1",
        "expected_status": "BLOCKED",
        "expected_reason": "APPLY_SCHEMA_INVALID"
      }
    }
  }
}
