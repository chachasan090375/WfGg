{
  "schema": "chacha.dev/project-control/v1",
  "principles": {
    "one_unified_control_surface": true,
    "control_plane_state_is_canonical": true,
    "api_and_cli_share_same_engine": true,
    "read_and_plan_are_default": true,
    "execution_is_never_implicit": true,
    "production_changes_require_explicit_human_approval": false,
    "cryptographic_release_requirements_are_visible_in_status": true,
    "private_signing_material_is_never_returned": true,
    "all_mutating_control_actions_are_auditable": true,
    "lifecycle_promotion_is_transactional": true,
    "verified_evidence_can_be_staged_before_audit_commit": true,
    "pending_control_transactions_block_further_promotion": true,
    "transaction_recovery_is_forward_only": true,
    "audit_events_are_never_rolled_back_by_recovery": true,
    "platform_readiness_is_read_only_certification": true,
    "external_runtime_bindings_are_ephemeral_and_runner_owned": true,
    "independent_provider_results_never_self_verify": true,
    "product_requirement_enters_before_technical_design": true,
    "technical_design_precedes_implementation": true,
    "functional_intent_precedes_domain_decomposition": true,
    "domain_orchestration_precedes_specialist_provider_resolution": true,
    "zero_incremental_cost_is_default": true,
    "reversible_policy_qualified_changes_may_autopromote": true,
    "sensitive_changes_require_explicit_human_approval": true,
    "platform_is_application_agnostic": true,
    "every_project_is_factory_provisioned": true,
    "project_knowledge_promotes_to_generic_knowledge": true,
    "agent_foundry_precedes_domain_dispatch": true,
    "core_replan_required_after_foundry": true,
    "branch_foundry_parallel_with_agent_foundry": true,
    "lazy_branch_materialization": true,
    "central_memory_survives_branch_teardown": true
  },
  "interfaces": {
    "cli": {
      "enabled": true,
      "command": "project-control",
      "adapter": "dev-hub/bin/project-control-cli.py"
    },
    "json_api": {
      "enabled": true,
      "transport": "stdin-stdout",
      "network_listener": false,
      "adapter": "dev-hub/bin/project-control-api.py"
    }
  },
  "runtime": {
    "state_root": "/opt/chacha-dev/runtime/state",
    "evidence_root": "/opt/chacha-dev/runtime/evidence",
    "plans_root": "/opt/chacha-dev/runtime/plans",
    "health_root": "/opt/chacha-dev/runtime/health",
    "runs_root": "/opt/chacha-dev/runtime/runs",
    "transactions_root": "/opt/chacha-dev/runtime/transactions",
    "locks_root": "/opt/chacha-dev/runtime/locks/control"
  },
  "repository_paths": {
    "lifecycle": "dev-hub/config/lifecycle.v1.json",
    "quality_gates": "dev-hub/config/quality-gates.v1.json",
    "evidence_catalog": "dev-hub/config/evidence-catalog.v1.json",
    "orchestration": "dev-hub/config/orchestration-policy.v1.json",
    "capability_registry": "dev-hub/config/capability-registry.v1.json",
    "execution_scheduler": "dev-hub/config/execution-scheduler.v1.json",
    "run_controller": "dev-hub/config/run-controller.v1.json",
    "provider_adapters": "dev-hub/config/provider-adapters.v1.json",
    "verification_broker": "dev-hub/config/verification-broker.v1.json",
    "control_plane_state": "dev-hub/config/control-plane-state.v1.json",
    "cryptographic_trust": "dev-hub/config/cryptographic-trust.v1.json",
    "transaction_recovery": "dev-hub/config/transaction-recovery.v1.json",
    "platform_readiness": "dev-hub/config/platform-readiness.v1.json",
    "external_runtime_binding": "dev-hub/config/external-runtime-binding.v1.json",
    "agent_routing": "dev-hub/config/agent-routing.v1.json",
    "technical_design": "dev-hub/config/technical-design.v1.json",
    "domain_orchestration": "dev-hub/config/domain-orchestration.v1.json",
    "provider_economics": "dev-hub/config/provider-economics.v1.json",
    "technology_radar_domain_watch": "dev-hub/config/technology-radar-domain-watch.v2.json",
    "project_factory": "dev-hub/config/project-factory.v1.json",
    "knowledge_fabric": "dev-hub/config/knowledge-fabric.v1.json",
    "self_evolution": "dev-hub/config/self-evolution.v1.json",
    "agent_foundry": "dev-hub/config/agent-foundry.v1.json",
    "capability_foundry": "dev-hub/config/capability-foundry.v1.json",
    "domain_factories": "dev-hub/config/domain-factories.v1.json",
    "contract_registry": "dev-hub/config/contract-registry.v1.json",
    "acceptance_engine": "dev-hub/config/acceptance-engine.v1.json",
    "digital_twin": "dev-hub/config/digital-twin.v1.json",
    "competition_arena": "dev-hub/config/competition-arena.v1.json",
    "knowledge_lifecycle": "dev-hub/config/knowledge-lifecycle.v1.json",
    "recovery_orchestrator": "dev-hub/config/recovery-orchestrator.v1.json",
    "uncertainty_policy": "dev-hub/config/uncertainty-policy.v1.json",
    "autonomy_definition": "dev-hub/config/autonomy-definition.v1.json",
    "branch_foundry": "dev-hub/config/branch-foundry.v1.json"
  },
  "engine_paths": {
    "control_plane_store": "dev-hub/bin/control-plane-store.py",
    "lifecycle_engine": "dev-hub/bin/lifecycle-engine.py",
    "task_graph_engine": "dev-hub/bin/task-graph-engine.py",
    "execution_scheduler": "dev-hub/bin/execution-scheduler.py",
    "run_controller": "dev-hub/bin/external-runtime-dispatch.py",
    "core_run_controller": "dev-hub/bin/run-controller.py",
    "verification_broker": "dev-hub/bin/provider-aware-verification-broker.py",
    "core_verification_broker": "dev-hub/bin/verification-broker.py",
    "evidence_collector": "dev-hub/bin/evidence-collector.py",
    "crypto_trust": "dev-hub/bin/crypto-trust.py",
    "transaction_recovery": "dev-hub/bin/transaction-recovery.py",
    "platform_readiness": "dev-hub/bin/platform-readiness.py",
    "technical_design_router": "dev-hub/bin/technical-design-router.py",
    "functional_intent_orchestrator": "dev-hub/bin/functional-intent-orchestrator.py",
    "domain_provider_resolver": "dev-hub/bin/domain-provider-resolver.py",
    "project_factory": "dev-hub/bin/project-factory.py",
    "architecture_optimizer": "dev-hub/bin/architecture-optimizer.py",
    "agent_foundry_planner": "dev-hub/bin/agent-foundry-planner.py",
    "specification_compiler": "dev-hub/bin/specification-compiler.py",
    "autonomous_project_orchestrator": "dev-hub/bin/autonomous-project-orchestrator.py",
    "capability_foundry": "dev-hub/bin/capability-foundry.py",
    "component_factory": "dev-hub/bin/component-factory.py",
    "contract_registry": "dev-hub/bin/contract-registry.py",
    "acceptance_engine": "dev-hub/bin/acceptance-engine.py",
    "digital_twin_planner": "dev-hub/bin/digital-twin-planner.py",
    "competition_arena": "dev-hub/bin/competition-arena.py",
    "knowledge_compiler": "dev-hub/bin/knowledge-compiler.py",
    "uncertainty_resolver": "dev-hub/bin/uncertainty-resolver.py",
    "recovery_orchestrator": "dev-hub/bin/recovery-orchestrator.py",
    "autonomy_audit": "dev-hub/bin/autonomy-audit.py",
    "branch_foundry_planner": "dev-hub/bin/branch-foundry-planner.py",
    "branch_blueprint_optimizer": "dev-hub/bin/branch-blueprint-optimizer.py"
  },
  "status_model": [
    "READY",
    "BLOCKED",
    "AWAITING_APPROVAL",
    "DEGRADED",
    "UNKNOWN",
    "COMPLETE"
  ],
  "operations": {
    "status": {
      "class": "read",
      "mutating": false
    },
    "explain": {
      "class": "read",
      "mutating": false
    },
    "verify-state": {
      "class": "read",
      "mutating": false
    },
    "transactions": {
      "class": "read",
      "mutating": false
    },
    "recover-transaction": {
      "class": "recovery",
      "mutating": false,
      "apply_flag_makes_mutating": true
    },
    "platform-readiness": {
      "class": "verification",
      "mutating": false
    },
    "plan-transition": {
      "class": "plan",
      "mutating": false
    },
    "schedule": {
      "class": "plan",
      "mutating": false
    },
    "prepare-run": {
      "class": "plan",
      "mutating": false
    },
    "dispatch": {
      "class": "execution",
      "mutating": true,
      "explicit_flag_required": true
    },
    "verify-result": {
      "class": "verification",
      "mutating": false,
      "ingest_flag_makes_mutating": true
    },
    "record-control-event": {
      "class": "state-write",
      "mutating": true
    },
    "advance": {
      "class": "state-write",
      "mutating": true,
      "transition_recheck_required": true
    },
    "crypto-verify": {
      "class": "verification",
      "mutating": false
    },
    "technical-design": {
      "class": "plan",
      "mutating": false,
      "implementation_gate": "blocked-until-specialist-design-complete"
    },
    "functional-orchestrate": {
      "class": "plan",
      "mutating": false,
      "provider_resolution": "domain-owned",
      "technology_radar_required": true,
      "automatic_external_spend_eur": 0
    },
    "create-project": {
      "class": "plan",
      "mutating": false,
      "application_agnostic": true,
      "provisions_collectors": true
    },
    "optimize-architecture": {
      "class": "plan",
      "mutating": false,
      "technology_watch_required": true,
      "self_evolution_policy_required": true
    },
    "agent-foundry-plan": {
      "class": "plan",
      "mutating": false,
      "mandatory_before_domain_dispatch": true,
      "returns_to_core_orchestrator": true
    },
    "autonomous-bootstrap": {
      "class": "plan",
      "mutating": false,
      "application_agnostic": true,
      "sequence": [
        "SPEC",
        "PROJECT_FACTORY",
        "CORE_PREPLAN",
        "AGENT_FOUNDRY",
        "CAPABILITY_FOUNDRY_IF_NEEDED",
        "CORE_REPLAN"
      ],
      "domain_dispatch_after_success": true
    },
    "branch-foundry-plan": {
      "class": "plan",
      "mutating": false,
      "mandatory_before_domain_dispatch": true,
      "parallel_with": "agent-foundry-plan",
      "returns_to_core_orchestrator": true
    }
  },
  "transaction_policy": {
    "project_lock_required": true,
    "integrity_recheck_before_mutation": true,
    "integrity_recheck_after_state_commit": true,
    "journal_is_write_ahead_authority": true,
    "evidence_ingest_protocol": "stage-ledger-then-audit-then-atomic-finalize",
    "transaction_receipt_schema": "chacha.dev/control-transaction-receipt/v1",
    "pending_transaction_blocks_promotion": true,
    "recovery_policy": "dev-hub/config/transaction-recovery.v1.json",
    "recovery_requires_explicit_apply": true,
    "recovery_never_rewrites_audit_history": true,
    "protected_event_types": [
      "LIFECYCLE_TRANSITION",
      "APPROVAL_RECORDED",
      "RISK_ACCEPTANCE_RECORDED",
      "SIGNING_KEY_ACTIVATED",
      "SIGNING_KEY_ROTATED",
      "SIGNING_KEY_REVOKED",
      "PROJECT_RETIRED"
    ],
    "protected_state_sections": [
      "lifecycle",
      "approvals"
    ]
  },
  "approval_boundaries": {
    "new_external_spend": "explicit-human",
    "credential_or_identity_model_change": "explicit-human",
    "destructive_or_irreversible_migration": "explicit-human",
    "security_boundary_reduction": "explicit-human",
    "legal_or_license_exception": "explicit-human",
    "no_valid_rollback": "explicit-human"
  },
  "safety": {
    "allow_network_listener": false,
    "allow_shell_interpolation": false,
    "allow_implicit_dispatch": false,
    "allow_implicit_state_promotion": false,
    "allow_unverified_evidence_as_success": false,
    "allow_private_key_output": false,
    "allow_unsigned_release": false,
    "allow_generic_event_to_mutate_protected_state": false,
    "allow_implicit_transaction_recovery": false,
    "allow_audit_history_rollback": false,
    "allow_readiness_gate_to_enable_adapters": false,
    "allow_static_executable_for_external_adapter": false,
    "allow_task_selected_runtime_binding": false,
    "allow_independent_provider_to_mark_verified": false
  }
}
