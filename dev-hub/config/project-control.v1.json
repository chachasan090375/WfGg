{
  "schema": "chacha.dev/project-control/v1",
  "principles": {
    "one_unified_control_surface": true,
    "control_plane_state_is_canonical": true,
    "api_and_cli_share_same_engine": true,
    "read_and_plan_are_default": true,
    "execution_is_never_implicit": true,
    "production_changes_require_explicit_human_approval": true,
    "cryptographic_release_requirements_are_visible_in_status": true,
    "private_signing_material_is_never_returned": true,
    "all_mutating_control_actions_are_auditable": true,
    "lifecycle_promotion_is_transactional": true,
    "verified_evidence_can_be_staged_before_audit_commit": true,
    "pending_control_transactions_block_further_promotion": true,
    "transaction_recovery_is_forward_only": true,
    "audit_events_are_never_rolled_back_by_recovery": true,
    "platform_readiness_is_read_only_certification": true,
    "external_runtime_bindings_are_ephemeral_and_runner_owned": true,
    "independent_provider_results_never_self_verify": true,
    "operational_runs_use_project_control": true,
    "same_stage_operational_graphs_are_explicit": true
  },
  "interfaces": {
    "cli": {
      "enabled": true,
      "command": "project-control",
      "adapter": "dev-hub/bin/project-control-cli.py"
    },
    "json_api": {
      "enabled": true,
      "transport": "stdin-stdout",
      "network_listener": false,
      "adapter": "dev-hub/bin/project-control-api.py"
    }
  },
  "runtime": {
    "state_root": "/opt/chacha-dev/runtime/state",
    "evidence_root": "/opt/chacha-dev/runtime/evidence",
    "plans_root": "/opt/chacha-dev/runtime/plans",
    "health_root": "/opt/chacha-dev/runtime/health",
    "runs_root": "/opt/chacha-dev/runtime/runs",
    "transactions_root": "/opt/chacha-dev/runtime/transactions",
    "locks_root": "/opt/chacha-dev/runtime/locks/control"
  },
  "repository_paths": {
    "lifecycle": "dev-hub/config/lifecycle.v1.json",
    "quality_gates": "dev-hub/config/quality-gates.v1.json",
    "evidence_catalog": "dev-hub/config/evidence-catalog.v1.json",
    "orchestration": "dev-hub/config/orchestration-policy.v1.json",
    "capability_registry": "dev-hub/config/capability-registry.v1.json",
    "execution_scheduler": "dev-hub/config/execution-scheduler.v1.json",
    "run_controller": "dev-hub/config/run-controller.v1.json",
    "provider_adapters": "dev-hub/config/provider-adapters.v1.json",
    "verification_broker": "dev-hub/config/verification-broker.v1.json",
    "control_plane_state": "dev-hub/config/control-plane-state.v1.json",
    "cryptographic_trust": "dev-hub/config/cryptographic-trust.v1.json",
    "transaction_recovery": "dev-hub/config/transaction-recovery.v1.json",
    "platform_readiness": "dev-hub/config/platform-readiness.v1.json",
    "external_runtime_binding": "dev-hub/config/external-runtime-binding.v1.json",
    "run_controller_operate": "dev-hub/config/run-controller.operate.v1.json"
  },
  "engine_paths": {
    "control_plane_store": "dev-hub/bin/control-plane-store.py",
    "lifecycle_engine": "dev-hub/bin/lifecycle-engine.py",
    "task_graph_engine": "dev-hub/bin/task-graph-engine.py",
    "execution_scheduler": "dev-hub/bin/execution-scheduler.py",
    "run_controller": "dev-hub/bin/external-runtime-dispatch.py",
    "core_run_controller": "dev-hub/bin/run-controller.py",
    "verification_broker": "dev-hub/bin/provider-aware-verification-broker.py",
    "core_verification_broker": "dev-hub/bin/verification-broker.py",
    "evidence_collector": "dev-hub/bin/evidence-collector.py",
    "crypto_trust": "dev-hub/bin/crypto-trust.py",
    "transaction_recovery": "dev-hub/bin/transaction-recovery.py",
    "platform_readiness": "dev-hub/bin/platform-readiness.py"
  },
  "status_model": [
    "READY",
    "BLOCKED",
    "AWAITING_APPROVAL",
    "DEGRADED",
    "UNKNOWN",
    "COMPLETE"
  ],
  "operations": {
    "status": {
      "class": "read",
      "mutating": false
    },
    "explain": {
      "class": "read",
      "mutating": false
    },
    "verify-state": {
      "class": "read",
      "mutating": false
    },
    "transactions": {
      "class": "read",
      "mutating": false
    },
    "recover-transaction": {
      "class": "recovery",
      "mutating": false,
      "apply_flag_makes_mutating": true
    },
    "platform-readiness": {
      "class": "verification",
      "mutating": false
    },
    "plan-transition": {
      "class": "plan",
      "mutating": false
    },
    "schedule": {
      "class": "plan",
      "mutating": false
    },
    "prepare-run": {
      "class": "plan",
      "mutating": false
    },
    "dispatch": {
      "class": "execution",
      "mutating": true,
      "explicit_flag_required": true
    },
    "verify-result": {
      "class": "verification",
      "mutating": false,
      "ingest_flag_makes_mutating": true
    },
    "record-control-event": {
      "class": "state-write",
      "mutating": true
    },
    "advance": {
      "class": "state-write",
      "mutating": true,
      "transition_recheck_required": true
    },
    "crypto-verify": {
      "class": "verification",
      "mutating": false
    },
    "operate": {
      "class": "execution",
      "mutating": false,
      "execute_flag_makes_runtime_action": true,
      "explicit_flag_required": true
    }
  },
  "transaction_policy": {
    "project_lock_required": true,
    "integrity_recheck_before_mutation": true,
    "integrity_recheck_after_state_commit": true,
    "journal_is_write_ahead_authority": true,
    "evidence_ingest_protocol": "stage-ledger-then-audit-then-atomic-finalize",
    "transaction_receipt_schema": "chacha.dev/control-transaction-receipt/v1",
    "pending_transaction_blocks_promotion": true,
    "recovery_policy": "dev-hub/config/transaction-recovery.v1.json",
    "recovery_requires_explicit_apply": true,
    "recovery_never_rewrites_audit_history": true,
    "protected_event_types": [
      "LIFECYCLE_TRANSITION",
      "APPROVAL_RECORDED",
      "RISK_ACCEPTANCE_RECORDED",
      "SIGNING_KEY_ACTIVATED",
      "SIGNING_KEY_ROTATED",
      "SIGNING_KEY_REVOKED",
      "PROJECT_RETIRED"
    ],
    "protected_state_sections": [
      "lifecycle",
      "approvals"
    ]
  },
  "approval_boundaries": {
    "dispatch_production": "explicit-human",
    "advance_to_release": "explicit-human",
    "signing_key_activation": "explicit-human",
    "signing_key_rotation": "explicit-human",
    "signing_key_revocation": "explicit-human",
    "retirement": "explicit-human"
  },
  "safety": {
    "allow_network_listener": false,
    "allow_shell_interpolation": false,
    "allow_implicit_dispatch": false,
    "allow_implicit_state_promotion": false,
    "allow_unverified_evidence_as_success": false,
    "allow_private_key_output": false,
    "allow_unsigned_release": false,
    "allow_generic_event_to_mutate_protected_state": false,
    "allow_implicit_transaction_recovery": false,
    "allow_audit_history_rollback": false,
    "allow_readiness_gate_to_enable_adapters": false,
    "allow_static_executable_for_external_adapter": false,
    "allow_task_selected_runtime_binding": false,
    "allow_independent_provider_to_mark_verified": false
  }
}
