{
  "schema": "chacha.dev/project-control/v1",
  "principles": {
    "one_unified_control_surface": true,
    "control_plane_state_is_canonical": true,
    "api_and_cli_share_same_engine": true,
    "read_and_plan_are_default": true,
    "execution_is_never_implicit": true,
    "production_changes_require_explicit_human_approval": false,
    "cryptographic_release_requirements_are_visible_in_status": true,
    "private_signing_material_is_never_returned": true,
    "all_mutating_control_actions_are_auditable": true,
    "lifecycle_promotion_is_transactional": true,
    "verified_evidence_can_be_staged_before_audit_commit": true,
    "pending_control_transactions_block_further_promotion": true,
    "transaction_recovery_is_forward_only": true,
    "audit_events_are_never_rolled_back_by_recovery": true,
    "platform_readiness_is_read_only_certification": true,
    "external_runtime_bindings_are_ephemeral_and_runner_owned": true,
    "independent_provider_results_never_self_verify": true,
    "product_requirement_enters_before_technical_design": true,
    "technical_design_precedes_implementation": true,
    "functional_intent_precedes_domain_decomposition": true,
    "domain_orchestration_precedes_specialist_provider_resolution": true,
    "zero_incremental_cost_is_default": true,
    "reversible_policy_qualified_changes_may_autopromote": true,
    "sensitive_changes_require_explicit_human_approval": true,
    "platform_is_application_agnostic": true,
    "every_project_is_factory_provisioned": true,
    "project_knowledge_promotes_to_generic_knowledge": true,
    "agent_foundry_precedes_domain_dispatch": true,
    "core_replan_required_after_foundry": true,
    "branch_foundry_parallel_with_agent_foundry": true,
    "lazy_branch_materialization": true,
    "central_memory_survives_branch_teardown": true,
    "verified_evidence_learning_is_asynchronous": true,
    "verified_success_requires_exact_lineage_for_confidence": true,
    "learning_lineage_is_derived_from_trusted_dispatch": true,
    "untrusted_provider_learning_context_is_never_ingested": true,
    "verified_result_is_enriched_only_after_independent_verification": true,
    "assurance_exchange_is_external_neutral_correlation_plane": true,
    "guardian_sentinel_correlation_never_grants_mutation_authority": true,
    "assurance_optimization_feedback_returns_to_central_orchestrator": true,
    "architecture_optimization_requires_technology_watch_and_council": true,
    "embedded_assurance_is_mandatory_for_every_project": true,
    "embedded_assurance_local_probes_never_mutate_application": true,
    "project_assurance_identity_is_project_scoped": true,
    "peripheral_assurance_communicates_through_common_exchange": true,
    "five_local_assurance_probes_mandatory_for_every_project": true,
    "curator_bastion_intendant_incremental_feedback_to_exchange": true,
    "specialized_peripheral_agents_never_self_authorize_architecture_change": true,
    "all_peripheral_agents_must_communicate_via_assurance_exchange": true,
    "cross_agent_optimization_feedback_returns_to_central_orchestrator": true,
    "logician_challenges_backend_plan_before_final_architecture": true,
    "ergonomist_challenges_user_experience_before_final_architecture": true,
    "central_brain_must_try_compromise_before_agent_revision": true,
    "current_plan_has_no_incumbency_privilege": true,
    "agent_revision_request_requires_failed_central_compromise": true,
    "final_version_requires_seven_agent_compromise_release_receipt": true,
    "missing_specialist_agent_review_blocks_final_delivery": true,
    "curator_central_authority_external": true,
    "bastion_central_authority_external": true,
    "intendant_central_authority_external": true,
    "specialist_reviews_are_source_reverified_by_assurance_exchange": true,
    "final_release_requires_real_specialist_authority_reviews": true,
    "bastion_may_contain_quarantine_revoke_under_policy": true,
    "bastion_emergency_control_requires_critical_scope_and_independent_corroboration": true,
    "bastion_failover_reserved_until_active_passive_ha_exists": true,
    "compromised_state_must_never_be_blindly_replicated_to_future_passive": true,
    "local_acceptance_is_provisional": true,
    "seven_agent_final_delivery_receipt_is_only_delivery_authority": true,
    "logician_post_implementation_second_read_required": true,
    "ergonomist_post_implementation_second_read_required": true,
    "five_external_final_reviews_must_be_source_reverified": true,
    "remediation_precedes_agent_renegotiation_when_implementation_drifts": true,
    "automatic_seven_agent_finalization_on_preview_release": true,
    "automatic_finalization_uses_verified_input_bundle": true,
    "automatic_finalization_is_transactional": true,
    "automatic_finalization_is_idempotent": true,
    "automatic_finalization_never_bypasses_non_finalization_release_blockers": true,
    "automatic_finalization_failure_never_promotes_release": true,
    "human_approval_recorded_only_via_protected_control_operation": true,
    "autonomous_golden_path_stops_at_human_boundaries": true,
    "autonomous_golden_path_resumes_after_recorded_approval": true,
    "v638_single_canonical_materializer": true,
    "production_deployment_requires_explicit_human_approval": true,
    "release_and_operate_are_distinct": true,
    "production_deployment_must_use_controlled_adapter": true,
    "production_evidence_must_come_from_real_target": true,
    "control_plane_bootstrap_uses_canonical_engines": true,
    "control_plane_bootstrap_is_idempotent": true,
    "control_plane_bootstrap_recovery_is_forward_only": true
  },
  "interfaces": {
    "cli": {
      "enabled": true,
      "command": "project-control",
      "adapter": "dev-hub/bin/project-control-cli.py"
    },
    "json_api": {
      "enabled": true,
      "transport": "stdin-stdout",
      "network_listener": false,
      "adapter": "dev-hub/bin/project-control-api.py"
    }
  },
  "runtime": {
    "state_root": "/opt/chacha-dev/runtime/state",
    "evidence_root": "/opt/chacha-dev/runtime/evidence",
    "plans_root": "/opt/chacha-dev/runtime/plans",
    "health_root": "/opt/chacha-dev/runtime/health",
    "runs_root": "/opt/chacha-dev/runtime/runs",
    "transactions_root": "/opt/chacha-dev/runtime/transactions",
    "locks_root": "/opt/chacha-dev/runtime/locks/control"
  },
