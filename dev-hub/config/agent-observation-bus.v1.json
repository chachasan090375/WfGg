{
  "schema": "chacha.dev/agent-observation-bus-policy/v1",
  "version": "1.5.0",
  "purpose": "Collect evidence-backed agent observations at common ChaCha DEV boundaries and trigger reassessment without self-mutation.",
  "storage": {
    "database": "agent-observation/observations.db",
    "reassessment_queue": "agent-evolution/reassessment-queue",
    "append_only": true,
    "hash_chain": true,
    "event_id_deduplication": true,
    "runtime_root_relative": true,
    "isolated_test_runtime_must_not_touch_canonical": true
  },
  "verification": {
    "levels": [
      "SELF_ASSERTED",
      "OBSERVED",
      "VERIFIED"
    ],
    "independent_verified_sources": [
      "project-control",
      "verification-broker",
      "guardian",
      "sentinel",
      "architecture-decision-council",
      "technology-watch-agent",
      "seven-agent-final-compromise-controller"
    ],
    "producer_self_assertion_can_be_verified": false,
    "verified_requires_evidence_refs": true,
    "unknown_source_requested_verified_downgrades_to_observed": true,
    "independent_observed_sources": [
      "run-controller",
      "central-orchestrator",
      "recovery-orchestrator"
    ]
  },
  "lineage": {
    "required": [
      "event_id",
      "event_type",
      "source_id",
      "source_surface",
      "project_id",
      "subject_role",
      "outcome",
      "revision"
    ],
    "optional": [
      "run_id",
      "task_id",
      "capabilities",
      "severity",
      "details"
    ]
  },
  "triggers": {
    "verified_only": true,
    "event_types": [
      "VERIFIED_FAILURE",
      "ROLLBACK",
      "SECURITY_INCIDENT",
      "REPEATED_REMEDIATION",
      "HANDOFF_FAILURE",
      "TECHNOLOGY_WATCH_MATERIAL_DELTA",
      "SOURCE_CONFIDENCE_DROP",
      "DEPENDENCY_EOL_OR_DEPRECATION",
      "PERFORMANCE_REGRESSION",
      "PERMISSION_DRIFT",
      "HANDOFF_FAILURE_CLUSTER"
    ],
    "derived": [
      {
        "event_type": "TASK_RESULT_VERIFIED",
        "outcome": "FAILED",
        "trigger": "VERIFIED_FAILURE"
      },
      {
        "event_type": "TASK_RESULT_VERIFIED",
        "outcome": "BLOCKED",
        "trigger": "VERIFIED_FAILURE"
      }
    ],
    "action": "REASSESS",
    "direct_agent_mutation": false,
    "direct_candidate_materialization": false,
    "candidate_owner": "agent-foundry",
    "architecture_council_final_authority": true,
    "self_reassessment_request": {
      "allowed": true,
      "event_type": "AGENT_REASSESSMENT_REQUEST",
      "requires_self_source": true,
      "verification": "SELF_ASSERTED",
      "metric_authority": false,
      "direct_agent_mutation": false
    }
  },
  "boundaries": {
    "run_controller": {
      "event_type": "TASK_EXECUTION_OBSERVED",
      "verification": "OBSERVED"
    },
    "project_control": {
      "event_type": "TASK_RESULT_VERIFIED",
      "verification": "VERIFIED"
    },
    "central_orchestrator": {
      "event_type": "STAGE_EXECUTION_OBSERVED",
      "verification": "OBSERVED"
    },
    "seven_agent_final_compromise": {
      "event_type": "FINAL_REVIEW_VERIFIED",
      "verification": "VERIFIED"
    },
    "recovery_orchestrator": {
      "event_type": "RECOVERY_DECISION_OBSERVED",
      "verification": "OBSERVED",
      "quality_claim": false
    }
  },
  "authority": {
    "agent_self_scoring_authority": false,
    "logician_advisory": true,
    "technology_watch_revalidation_required": true,
    "guardian_preserved": true,
    "sentinel_preserved": true,
    "architecture_council_final_authority": true
  },
  "economics": {
    "automatic_external_spend_eur": 0
  },
  "cadence": {
    "lightweight_health_hours": 24,
    "deep_agent_audit_days": 7,
    "ecosystem_benchmark_days": 30,
    "scheduled_reassessment_only": true,
    "direct_candidate_materialization": false
  },
  "self_health": {
    "enabled": true,
    "monitor": "agent-observation-bus-health",
    "health_report": "agent-observation/bus-health-latest.json",
    "state": "agent-observation/bus-health-state.json",
    "platform_reassessment_queue": "platform-evolution/reassessment-queue",
    "lightweight_health_hours": 24,
    "deep_audit_days": 7,
    "ecosystem_benchmark_days": 30,
    "thresholds": {
      "max_reassessment_queue_backlog": 100,
      "max_shadow_publish_p95_ms": 100,
      "min_free_disk_pct": 10
    },
    "evolution": {
      "direct_self_mutation": false,
      "self_promotion": false,
      "monitor_can_promote": false,
      "technology_watch_revalidation_required": true,
      "logician_falsification_required": true,
      "candidate_owner": "capability-foundry",
      "candidate_isolated": true,
      "incumbent_control_group": true,
      "shadow_required": true,
      "pilot_required": true,
      "backward_compatibility_required": true,
      "exact_revision_evidence_required": true,
      "rollback_required": true,
      "guardian_required": true,
      "sentinel_required": true,
      "architecture_council_final_authority": true,
      "latest_version_priority": false
    },
    "falsification_routes": [
      "SELF_VERIFICATION_ATTACK",
      "SOURCE_SPOOFING",
      "HASH_CHAIN_TAMPER",
      "DUPLICATE_STORM",
      "CONCURRENT_PUBLISH",
      "SQLITE_INTEGRITY_FAILURE",
      "SCHEMA_DRIFT",
      "LEGACY_CONTRACT_COMPATIBILITY",
      "RUNTIME_ROOT_ESCAPE",
      "QUEUE_BACKLOG",
      "TRIGGER_FALSE_POSITIVE",
      "TRIGGER_FALSE_NEGATIVE",
      "AGENT_INVENTORY_CHANGE",
      "CAPABILITY_DRIFT",
      "STORAGE_PRESSURE",
      "LATENCY_REGRESSION"
    ]
  },
  "agent_change_integration": {
    "inventory_fingerprint_required": true,
    "role_change_requires_bus_reassessment": true,
    "capability_change_requires_bus_reassessment": true,
    "new_agent_requires_instrumentation_review": true,
    "removed_agent_requires_instrumentation_review": true,
    "generic_event_contract_must_survive_agent_changes": true
  },
  "historical_verified_backfill": {
    "enabled": true,
    "source_id": "project-control",
    "source_surface": "project-control:historical-verified-backfill",
    "event_type": "HISTORICAL_TASK_RESULT_VERIFIED",
    "minimum_age_minutes": 60,
    "require_verification_report": true,
    "require_report_checks_pass": true,
    "require_independent_verifier": true,
    "retroactive_reassessment": false,
    "production_truth": true,
    "idempotent_by_project_task": true
  }
}
