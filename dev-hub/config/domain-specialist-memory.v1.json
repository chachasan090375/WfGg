{
  "schema": "chacha.dev/domain-specialist-memory-policy/v1",
  "version": "1.0.0",
  "scope": "PLATFORM_GLOBAL",
  "purpose": "Turn domain branches into durable specialists through provenance-bound, continuously revalidated domain knowledge.",
  "domain_catalog": "dev-hub/config/domain-orchestration.v1.json",
  "agent_foundry": "dev-hub/config/agent-foundry.v1.json",
  "memory_namespace_template": "specialist:{domain}",
  "principles": {
    "generalist_central_memory_remains_fallback": true,
    "domain_memory_precedes_general_fallback_for_domain_tasks": true,
    "raw_scraped_content_never_becomes_fact": true,
    "provenance_required": true,
    "source_date_required": true,
    "contradictions_preserved_until_resolved": true,
    "stale_knowledge_must_be_revalidated": true,
    "memory_cannot_expand_permissions": true,
    "memory_cannot_grant_architecture_authority": true,
    "specialization_is_measured_not_declared": true,
    "automatic_external_spend_eur": 0
  },
  "source_planes": {
    "official_primary": {
      "priority": 1,
      "classes": [
        "official_documentation",
        "standards",
        "vendor_release_notes",
        "official_repositories"
      ]
    },
    "open_research": {
      "priority": 2,
      "classes": [
        "public_web",
        "public_code_repositories",
        "papers",
        "community_discussions"
      ],
      "technology_watch_required": true
    },
    "dark_intelligence": {
      "priority": 3,
      "classes": [
        "deep_web",
        "tor_onion",
        "threat_intelligence_feed"
      ],
      "direct_ingestion_forbidden": true,
      "accepted_input": "CORROBORATED_TECHNOLOGY_DOSSIER_ONLY",
      "isolation_required": true,
      "bastion_boundary_required": true
    }
  },
  "verification": {
    "technology_truth_scoring_required": true,
    "source_reputation_required": true,
    "logician_falsification_required_for_material_claims": true,
    "cross_source_corroboration_required_for_high_confidence": true,
    "minimum_independent_support_groups": 2,
    "unverified_claim_state": "PROVISIONAL",
    "contradicted_claim_state": "QUARANTINED",
    "trusted_claim_state": "TRUSTED"
  },
  "knowledge_record": {
    "required": [
      "domain",
      "knowledge_key",
      "claim_digest",
      "source_refs",
      "source_classes",
      "observed_at",
      "valid_from",
      "confidence",
      "trust_state",
      "evidence_digest"
    ],
    "raw_user_content_forbidden": true,
    "secrets_forbidden": true,
    "binary_payload_forbidden": true,
    "source_instruction_authority": false
  },
  "lifecycle": [
    "DISCOVERED",
    "PROVISIONAL",
    "CORROBORATED",
    "TRUSTED",
    "STALE",
    "QUARANTINED",
    "SUPERSEDED"
  ],
  "revalidation": {
    "trusted_max_age_days_default": 30,
    "security_max_age_days": 7,
    "framework_release_max_age_days": 14,
    "revalidate_on_use_if_stale": true
  },
  "agent_integration": {
    "context_order": [
      "specialist_domain_memory",
      "project_domain_memory",
      "central_memory_fallback"
    ],
    "foundry_reuse_score_uses_specialist_coverage": true,
    "new_reusable_agent_requires_domain_memory_policy": true,
    "agent_evolution_may_propose_memory_gap_research": true,
    "agent_self_training_from_unverified_sources_forbidden": true
  },
  "storage": {
    "hot": "VPS",
    "long_term": "NAS",
    "tiering_policy": "dev-hub/config/cognitive-memory-fabric.v1.json",
    "raw_source_archive_is_not_agent_memory": true
  },
  "activation": {
    "production_activation_authorized": false,
    "shadow_only": true
  },
  "specialization_score": {
    "status": "DESIGNED_SHADOW_ONLY",
    "minimum_expert_score": 80,
    "dimensions": {
      "domain_coverage": 25,
      "freshness": 15,
      "source_provenance_quality": 15,
      "corroboration_depth": 15,
      "contradiction_resolution": 10,
      "domain_benchmark_performance": 20
    },
    "expert_label_requires_benchmark_pass": true,
    "expert_label_requires_minimum_trusted_records": true,
    "minimum_trusted_records_default": 50,
    "score_cannot_expand_permissions": true,
    "score_cannot_self_promote_agent": true
  }
}
