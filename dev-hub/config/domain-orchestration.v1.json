    "functional_intent_is_source_of_truth": true,
    "decompose_before_dispatch": true,
    "route_by_domain_then_capability": true,
    "domain_orchestrator_selects_provider": true,
    "provider_choice_is_runtime_not_product_decision": true,
    "free_first": true,
    "evidence_required": true,
    "cross_domain_review_required": true,
    "technology_radar_advises_all_domains": true,
    "production_change_requires_human_approval": true
  },
