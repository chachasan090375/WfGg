  "assembly_policy": {
    "required_for_multi_domain_change": true,
    "required_for_delivery": true,
    "contract_reconciliation": true,
    "unresolved_contract_mismatch_blocks_delivery": true,
    "returns_to_core_orchestrator_after_assembly": true
  },
  "execution_pipeline": [
    "SPEC",
    "CONTEXT",
    "PROJECT_FACTORY",
    "CORE_PREPLAN",
    "AGENT_FOUNDRY",
    "CAPABILITY_GAP_ANALYSIS",
    "CAPABILITY_FOUNDRY_IF_NEEDED",
    "CORE_REPLAN",
    "AGENT_FOUNDRY_RECHECK_IF_PLAN_CHANGED",
    "DOMAIN_FACTORIES",
    "CONTRACT_RECONCILIATION",
    "ASSEMBLY",
    "DIGITAL_TWIN",
    "ACCEPTANCE",
    "DELIVERY",
    "OBSERVABILITY",
    "RECOVERY",
    "KNOWLEDGE_COMPILER",
    "KNOWLEDGE_PROMOTION",
    "AUTONOMY_AUDIT"
  ],
  "preflight": {
    "first_executable_branch": "agent-foundry",
    "policy": "dev-hub/config/agent-foundry.v1.json",
    "domain_dispatch_before_foundry": false,
    "core_replan_after_foundry": true,
    "capability_foundry_policy": "dev-hub/config/capability-foundry.v1.json",
    "capability_foundry_before_domain_dispatch": true,
    "agent_foundry_rerun_after_capability_creation": true
  },
  "factories": {
    "policy": "dev-hub/config/domain-factories.v1.json",
    "every_domain_is_component_factory": true,
    "component_registry_per_project": true,
    "reusable_components_promote_to_platform_catalog": true
