{
  "schema": "chacha.dev/domain-orchestration/v1",
  "version": "6.3.0",
  "core_orchestrator": "chacha-core-orchestrator",
  "principles": {
    "functional_intent_is_source_of_truth": true,
    "decompose_before_dispatch": true,
    "route_by_domain_then_capability": true,
    "domain_orchestrator_selects_provider": true,
    "provider_choice_is_runtime_not_product_decision": true,
    "free_first": true,
    "evidence_required": true,
    "cross_domain_review_required": true,
    "production_change_requires_human_approval": false,
    "platform_is_application_agnostic": true,
    "every_application_is_a_project_instance": true,
    "every_project_gets_project_collector": true,
    "every_active_domain_gets_project_domain_collector": true,
    "reusable_knowledge_promotes_to_generic_domain_collectors": true,
    "assembly_orchestrator_reconciles_domain_outputs": true,
    "technology_watch_drives_architecture_optimization": true,
    "self_improvement_is_continuous": true,
    "autonomous_safe_self_upgrade": true,
    "sensitive_change_requires_human_approval": true,
    "agent_foundry_precedes_all_domain_execution": true,
    "core_replans_after_agent_topology": true
  },
  "request_modes": {
    "simple_question": {
      "max_primary_domains": 1,
      "implementation_allowed": false
    },
    "focused_change": {
      "max_primary_domains": 2,
      "implementation_allowed": true
    },
    "multi_domain_change": {
      "max_primary_domains": 12,
      "implementation_allowed": true
    }
  },
