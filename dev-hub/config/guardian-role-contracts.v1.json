  "schema": "chacha.dev/guardian-role-contracts/v1",
  "version": "2.1.0",
  "scope": "PLATFORM_GLOBAL",
  "principles": {
    "guardian_is_external_to_central_brain": true,
    "guardian_cannot_build_or_choose_architecture": true,
    "guardian_cannot_modify_own_contracts_at_runtime": true,
    "every_governed_action_requires_actor_and_subject_contract": true,
    "sensitive_actions_fail_closed": true,
    "low_risk_guardian_unavailability_may_continue_unverified": false,
    "pass_requires_evidence_not_self_assertion": true,
    "guardian_static_policy_cannot_self_mutate_at_runtime": true,
    "dynamic_instance_contracts_may_be_registered_only_under_immutable_template": true,
    "dynamic_instance_contracts_cannot_escalate_template_privileges": true,
    "dynamic_branch_and_orchestrator_contracts_are_versioned": true,
    "dynamic_component_contracts_cannot_escalate_template_privileges": true
  },
  "sensitive_permissions": [
    "production-deploy",
