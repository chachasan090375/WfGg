{
  "schema": "chacha.dev/agent-fleet-observatory-policy/v1",
  "version": "1.13.0",
  "purpose": "Build evidence-backed agent metrics from ChaCha DEV runtime artifacts without assigning scores to unmeasured dimensions.",
  "runtime_sources": {
    "task_graphs": "plans/**/*.task-graph.json",
    "run_records": "runs/**/run-record.json",
    "verified_task_results": "transactions/**/verified-task-result.json",
    "component_confidence": "knowledge/component-confidence.json",
    "agent_observation_bus": "agent-observation/observations.db"
  },
  "role_aliases": {
    "product-domain": "product-domain-architect",
    "frontend": "frontend-architect",
    "backend-api": "backend-api-architect",
    "data": "data-architect",
    "security": "security-reviewer",
    "testing": "test-engineer",
    "platform": "platform-cloud-engineer",
    "sre-observability": "sre-observability-engineer",
    "performance": "performance-engineer",
    "recovery": "recovery-engineer",
    "release": "release-engineer",
    "documentation": "documentation-adr-agent",
    "integration": "integration-architect",
    "technology-watch": "technology-watch-agent",
    "agent-foundry": "agent-foundry-architect",
    "branch-foundry": "branch-foundry-architect",
    "capability-foundry": "capability-foundry-architect",
    "logician": "logician",
    "ergonomist": "ergonomist",
    "guardian": "guardian",
    "sentinel": "sentinel",
    "curator": "curator",
    "bastion": "bastion",
    "intendant": "intendant"
  },
  "default_agent_risk_overrides": {
    "guardian": "high",
    "sentinel": "high",
    "bastion": "critical",
    "curator": "medium",
    "intendant": "medium",
    "logician": "medium",
    "ergonomist": "medium",
    "technology-radar-agent": "medium"
  },
  "dimension_sources": {
    "accuracy": "independently verified task results",
    "evidence_quality": "verified results carrying non-empty evidence",
    "robustness": "actual dispatched executions excluding PREPARED/SKIPPED",
    "efficiency": "attempt/retry overhead on actual executions",
    "authority_discipline": "Guardian pre/post verdicts attached to executions",
    "learning_quality": "exact agent component-confidence state",
    "coverage": "Agent Observation Bus capability exercise versus declared routing capabilities",
    "handoff_quality": "independently verified Project Control task-result handoffs"
  },
  "confidence_state_scores": {
    "TRUSTED": 95,
    "PROVISIONAL": 75,
    "OBSERVED": 60,
    "RECOVERY_CANDIDATE": 45,
    "DEGRADED": 30,
    "QUARANTINED": 5
  },
  "scoring_rules": {
    "minimum_events_per_dimension": 1,
    "prepared_tasks_are_not_execution_evidence": true,
    "blocked_tasks_are_not_automatic_agent_failures": true,
    "ambiguous_task_role_is_not_attributed": true,
    "unverified_results_do_not_count_as_accuracy_evidence": true,
    "unknown_is_not_zero": true,
    "unknown_is_not_fifty": true,
    "self_asserted_bus_events_are_verified_evidence": false,
    "verified_handoff_requires_independent_bus_event": true
  },
  "queues": {
    "optimization_recommendations": [
      "BLOCK_AND_REVIEW",
      "SHADOW_CANDIDATE",
      "OPTIMIZE"
    ],
    "measurement_recommendations": [
      "MEASURE_FIRST",
      "MEASURE_MORE"
    ],
    "risk_priority": [
      "critical",
      "high",
      "medium",
      "low"
    ]
  },
  "authority": {
    "read_only": true,
    "no_self_scoring_authority": true,
    "agent_foundry_owns_candidate_materialization": true,
    "logician_is_advisory": true,
    "technology_watch_revalidation_required": true,
    "guardian_preserved": true,
    "sentinel_preserved": true,
    "architecture_council_final_authority": true
  },
  "economics": {
    "automatic_external_spend_eur": 0
  },
  "observation_bus": {
    "trusted_observed_sources": [
      "run-controller",
      "central-orchestrator",
      "recovery-orchestrator"
    ],
    "untrusted_observed_capability_evidence_ignored": true,
    "aborted_revision_quarantine": {
      "enabled": true,
      "event_type": "RUNTIME_REVISION_ABORTED",
      "allowed_verifications": [
        "OBSERVED",
        "VERIFIED"
      ],
      "trusted_sources": [
        "central-orchestrator",
        "guardian",
        "sentinel"
      ],
      "required_outcome": "ABORTED",
      "require_evidence_refs": true,
      "metric_action": "EXCLUDE_ABORTED_REVISION_EVENTS",
      "historical_bus_rewrite": false
    }
  },
  "benchmark_evidence": {
    "promoted_dir": "agent-evolution/benchmark-evidence",
    "verification": "BENCHMARK_VERIFIED",
    "truth_scope": "BENCHMARK_ONLY",
    "production_truth_eligible": false,
    "fill_unmeasured_dimensions_only": true,
    "overwrite_production_measurement": false
  },
  "specialist_review_evidence": {
    "enabled": true,
    "glob": "plans/**/automatic-finalization/**/reviews/*-source-reverified-review.json",
    "eligible_agents": [
      "curator",
      "intendant",
      "bastion"
    ],
    "required_schema": "chacha.dev/compromise-agent-review/v1",
    "required_source_authority": "EXTERNAL",
    "source_reverified_required": true,
    "post_implementation_second_read_required": true,
    "implementation_verified_required": true,
    "direct_mutation_must_be_false_for_authority_score": true,
    "production_truth": true
  },
  "project_local_adapter_evidence": {
    "enabled": true,
    "glob": "adapter-promotions/radar-runtime-adapter/**/promotion-evidence.json",
    "eligible_agent": "technology-radar-agent",
    "adapter": "radar-runtime-adapter",
    "required_scope": "PROJECT",
    "required_evidence": [
      "runtime-contract-pass",
      "sandbox-only",
      "provisioning-pass"
    ],
    "production_truth_dimensions": [
      "evidence_quality",
      "authority_discipline"
    ],
    "accuracy_from_adapter_promotion": false,
    "handoff_from_unverified_task_results": false
  },
  "golden_path_operational_evidence": {
    "enabled": true,
    "guardian": {
      "glob": "golden-path-runs/**/external-assurance/guardian-functional-receipt.json",
      "required_schema": "chacha.dev/guardian-functional-acceptance-receipt/v1",
      "required_guardian": "external-worker",
      "required_delivery_status": "DELIVERED",
      "production_truth_dimensions": [
        "evidence_quality",
        "handoff_quality",
        "authority_discipline"
      ],
      "accuracy_inference": false
    },
    "sentinel": {
      "glob": "golden-path-runs/**/external-assurance/sentinel-technical-receipt.json",
      "required_schema": "chacha.dev/sentinel-technical-receipt/v1",
      "required_sentinel": "external-worker",
      "required_verification_source": "D1_WORKFLOW_ATTESTATION",
      "required_delivery_status": "DELIVERED",
      "production_truth_dimensions": [
        "evidence_quality",
        "handoff_quality",
        "authority_discipline"
      ],
      "accuracy_inference": false
    },
    "acceptance-engineer": {
      "glob": "golden-path-runs/**/external-assurance/acceptance.json",
      "required_schema": "chacha.dev/acceptance-result/v1",
      "evidence_peer_filename": "acceptance-evidence.json",
      "production_truth_dimensions": [
        "evidence_quality",
        "handoff_quality",
        "authority_discipline"
      ],
      "accuracy_inference": false
    }
  },
  "independent_accuracy_attestation": {
    "enabled": true,
    "glob": "agent-evolution/independent-accuracy-attestations/**/accuracy-*.json",
    "required_schema": "chacha.dev/independent-accuracy-attestation/v1",
    "required_verifier": "v660-independent-accuracy-attestor",
    "required_verification": "INDEPENDENTLY_ATTESTED",
    "required_scope": "REAL_RUNTIME",
    "eligible_agents": [
      "guardian",
      "sentinel",
      "acceptance-engineer"
    ],
    "production_truth_dimensions": [
      "accuracy"
    ],
    "canonical_observation_bus_mutation": false,
    "automatic_external_spend_eur": 0
  },
  "real_world_structural_attestation": {
    "enabled": true,
    "glob": "agent-evolution/real-world-attestations/**/attestation-*.json",
    "required_schema": "chacha.dev/real-world-agent-attestation/v1",
    "required_verifier": "v662-real-world-evidence-attestor",
    "required_verification": "INDEPENDENTLY_RECOMPUTED",
    "required_scope": "REAL_RUNTIME",
    "eligible_agents": [
      "agent-foundry-architect",
      "branch-foundry-architect",
      "capability-foundry-architect",
      "logician",
      "technology-watch-agent",
      "ergonomist"
    ],
    "production_truth_dimensions": [
      "evidence_quality",
      "handoff_quality",
      "authority_discipline"
    ],
    "accuracy_inference": false,
    "canonical_observation_bus_mutation": false,
    "automatic_external_spend_eur": 0
  },
  "project_local_runtime_coverage": {
    "enabled": true,
    "eligible_agent": "technology-radar-agent",
    "required_scope": "PROJECT",
    "project_id": "wfgg-radar",
    "run_glob": "runs/wfgg-radar/**/run-record.json",
    "provider": "radar-vps-runtime",
    "adapter": "radar-runtime-adapter",
    "required_task_status": "SUCCEEDED",
    "require_no_fallback": true,
    "allowed_capabilities": [
      "radar-runtime-inspect",
      "radar-pilot-control"
    ],
    "production_truth_dimensions": [
      "coverage"
    ],
    "accuracy_inference": false,
    "automatic_external_spend_eur": 0,
    "require_subject_agent_binding": true,
    "required_subject_agent": "technology-radar-agent",
    "subject_agent_sources": [
      "dispatch_envelope.task.subject_agent",
      "dispatch_envelope.task.agent_id",
      "dispatch_envelope.task.owner_role"
    ],
    "provider_binding_alone_is_agent_attribution": false
  }
}
