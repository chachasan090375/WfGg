{
  "schema": "chacha.dev/guardian-runtime-policy/v1",
  "version": "1.4.0",
  "scope": "PLATFORM_GLOBAL",
  "external_url": "https://chacha-dev-guardian.chachasan090375.workers.dev",
  "private_key": "/opt/chacha-dev/runtime/secrets/central-learning-key.pem",
  "fail_closed_permissions": [
    "repository-write",
    "preview-deploy",
    "production-deploy",
    "production-data-write",
    "secret-change",
    "destructive-operation",
    "technology-replacement"
  ],
  "low_risk_unavailable_verdict": "BLOCK",
  "sensitive_unavailable_verdict": "BLOCK",
  "alert_poll_seconds": 60,
  "local_alert_dir": "/opt/chacha-dev/runtime/guardian/alerts",
  "critical_stop_required_file": "/opt/chacha-dev/runtime/control/guardian-stop-required.json",
  "auto_activate_emergency_stop": false,
  "automatic_external_spend_eur": 0,
  "all_governed_actions_require_realtime_verdict": true,
  "action_lease_required": true,
  "action_lease_default_seconds": 300,
  "coverage_heartbeat_required": true,
  "coverage_heartbeat_max_age_seconds": 900,
  "safety_exemptions": [
    "emergency-control-bridge"
  ],
  "local_remediation_dir": "/opt/chacha-dev/runtime/guardian/remediations",
  "local_remediation_index": "/opt/chacha-dev/runtime/guardian/remediation-index.json",
  "corrective_enforcement": {
    "enabled": true,
    "guardian_may_issue_directives": true,
    "guardian_may_enforce_holds": true,
    "guardian_may_rewrite_architecture": false,
    "guardian_may_expand_permissions": false,
    "responsible_component_must_reapply_rules": true,
    "corrected_action_must_be_resubmitted": true,
    "max_failed_correction_attempts": 3,
    "escalation_after_max_attempts": "CRITICAL_STOP_REQUIRED",
    "remediation_poll_seconds": 30
  },
  "external_dual_assurance": {
    "enabled": true,
    "production_requires_guardian_functional_receipt": true,
    "production_requires_sentinel_technical_receipt": true,
    "exact_revision_match_required": true,
    "functional_contract_pinned_externally": true,
    "sentinel_receipt_verified_by_guardian": true,
    "guardian_may_modify_application": false,
    "sentinel_may_modify_application": false,
    "remediation_owner": "central-orchestrator"
  },
  "d1_write_budget": {
    "mode": "FREE_TIER_ZERO_COST",
    "coverage_heartbeat_interval_seconds": 300,
    "coverage_heartbeat_max_age_seconds": 900,
    "ci_sync_mode": "DIGEST_AWARE_DELTA",
    "redundant_ci_rewrites_forbidden": true,
    "automatic_paid_upgrade": false,
    "automatic_external_spend_eur": 0
  }
}
