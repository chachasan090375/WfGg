{
  "schema": "chacha.dev/android-native-update-policy/v1",
  "version": "1.1.0",
  "app_id": "com.wfgg.chachadev.operator",
  "manifest_path": "/api/v1/native-update",
  "package_path_prefix": "/native-updates/",
  "pinned_signing_certificate_sha256": "3a39f13de1191aec28526d5d8e7c9b490723d514b8dd87e5cb30aaa86a6bff88",
  "runtime_root": "/opt/chacha-dev/runtime/native-update",
  "default_status": "NONE",
  "invariants": {
    "stable_signing_certificate_required": true,
    "package_id_must_match": true,
    "version_code_must_increase": true,
    "apk_sha256_must_match": true,
    "signing_certificate_must_match_pinned": true,
    "same_private_origin_only": true,
    "user_android_install_confirmation_required": true,
    "silent_install_not_assumed": true,
    "central_orchestrator_publish_handoff_required": true,
    "guardian_required": true,
    "sentinel_exact_sha_required": true,
    "automatic_external_spend_eur": 0,
    "atomic_publish_required": true,
    "rollback_required": true,
    "apksigner_verification_required": true,
    "native_update_manifest_is_private": true
  },
  "retention": 2,
  "required_workflows": [
    "ChaCha DEV V7.6 native update qualification",
    "ChaCha DEV Sentinel technical assurance"
  ]
}
