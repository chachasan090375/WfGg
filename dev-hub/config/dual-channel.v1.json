      "central_build_orchestrator_required": false,
      "scheduler_allowed": false,
      "run_controller_allowed": false,
      "production_mutation_allowed": false,
      "advisory_bus_allowed": true,
      "research_broker_allowed": true,
      "dialogue_orchestrator_allowed": true,
      "label": "ChaCha",
      "purpose": "Natural conversation, read-only advice and information research.",
      "heavy_build_pipeline": false,
      "mutation_authority": false,
      "execution_authority": false,
      "production_authority": false,
      "allowed_routes": [
        "CHAT",
        "ADVISORY",
        "RESEARCH",
        "BUILD_HANDOFF_REQUIRED"
      ]
    },
    "BUILD": {
      "display_name": "Créer",
      "icon": "🛠️",
