      "central_build_orchestrator_required": true,
      "scheduler_allowed": true,
      "run_controller_allowed": true,
      "production_mutation_allowed": "ONLY_THROUGH_EXISTING_GOVERNED_PATH",
      "advisory_bus_allowed": true,
      "research_broker_allowed": true,
      "dialogue_orchestrator_allowed": true,
      "label": "Créer",
      "purpose": "Existing ChaCha DEV creation and execution pipeline.",
      "heavy_build_pipeline": true,
      "mutation_authority": "UNCHANGED_EXISTING_GOVERNANCE",
      "execution_authority": "UNCHANGED_EXISTING_GOVERNANCE",
      "production_authority": "UNCHANGED_EXISTING_GOVERNANCE"
    }
  },
  "routing": {
    "manual_switch_is_authoritative": true,
    "conversation_never_auto_escalates_to_build": true,
    "mutation_request_in_conversation": "AWAIT_EXPLICIT_CHANNEL_SWITCH",
    "build_never_downgrades_guardian_or_sentinel": true,
    "emergency_stop_is_global": true,
    "manual_switch_authoritative": true,
    "conversation_never_auto_switches_to_build": true,
    "build_handoff_requires_explicit_user_switch": true,
    "conversation_channel_may_create_creation_brief": true,
    "shared_timeline": true,
    "shared_human_profile": true,
    "shared_persona": true,
    "shared_central_memory_read_only": true
  },
  "shared": {
    "conversation_timeline": true,
    "human_profile": true,
    "assistant_persona": true,
    "central_memory": "ADVISORY_ONLY_IN_CONVERSATION",
    "human_behavior_center": "ADVISORY_ONLY_IN_CONVERSATION",
    "technology_watch": "CACHED_READ_ONLY_IN_CONVERSATION"
  },
  "automatic_external_spend_eur": 0,
  "conversation": {
    "default_subroute": "CHAT",
    "research_subroute": "RESEARCH",
    "advisory_subroute": "ADVISORY",
