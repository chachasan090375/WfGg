  "research_broker": {
    "read_only": true,
    "technology_watch_available": true,
    "general_web_provider": "UNBOUND",
    "source_citations_required_when_external_provider_is_bound": true,
    "may_not_purchase_access": true
  },
  "conversation_reasoner": {
    "provider": "agy-gemini-conversation",
    "zero_cost_attestation_required": true,
    "tool_access": "NONE",
    "execution_authority": false,
    "mutation_authority": false
  }
