{
  "schema": "chacha.dev/project-embedded-assurance-policy/v1",
  "version": "1.2.0",
  "scope": "PLATFORM_GLOBAL",
  "mandatory_for_all_projects": true,
  "bundle": {
    "manifest": "embedded-assurance.json",
    "guardian_local": "guardian-local",
    "sentinel_local": "sentinel-local",
    "relay": "project-assurance-relay",
    "outbox": "outbox",
    "delivered": "delivered"
  },
  "local_agents": {
    "guardian": {
      "role": "functional-observer",
      "allowed_event_types": [
        "functional-miss",
        "journey-failure",
        "acceptance-regression",
        "user-visible-failure",
        "functional-latency"
      ],
      "direct_mutation": false,
      "status": "ACTIVE"
    },
    "sentinel": {
      "role": "technical-observer",
      "allowed_event_types": [
        "exception",
        "crash",
        "timeout",
        "latency-budget",
        "dependency-failure",
        "resource-pressure",
        "runtime-regression"
      ],
      "direct_mutation": false,
      "status": "ACTIVE"
    },
    "curator": {
      "role": "visual-ux-observer",
      "allowed_event_types": [
        "visual-regression",
        "layout-break",
        "responsive-regression",
        "contrast-regression",
        "iconography-inconsistency",
        "design-system-drift",
        "interaction-friction",
        "render-latency"
      ],
      "direct_mutation": false,
      "status": "ACTIVE"
    },
    "bastion": {
      "role": "security-data-observer",
      "allowed_event_types": [
        "auth-anomaly",
        "permission-drift",
        "secret-exposure-signal",
        "dependency-vulnerability-signal",
        "data-integrity-anomaly",
        "privacy-contract-violation",
        "unexpected-public-surface",
        "security-regression"
      ],
      "direct_mutation": false,
      "status": "ACTIVE"
    },
    "intendant": {
      "role": "cost-resource-observer",
      "allowed_event_types": [
        "resource-budget-drift",
        "external-cost-signal",
        "request-amplification",
        "idle-resource",
        "cache-efficiency-regression",
        "model-overuse",
        "storage-growth",
        "cost-regression"
      ],
      "direct_mutation": false,
      "status": "ACTIVE"
    }
  },
  "privacy": {
    "raw_user_content": false,
    "raw_request_body": false,
    "raw_response_body": false,
    "raw_prompt": false,
    "raw_message": false,
    "credentials": false,
    "secrets": false,
    "tokens": false,
    "email_addresses": false,
    "allow_fields": [
      "event_type",
      "severity",
      "code",
      "component_id",
      "component_version",
      "deployment_id",
      "metric_name",
      "metric_value",
      "metric_unit",
      "duration_ms",
      "status_code",
      "evidence_digest",
      "route_template",
      "operation",
      "observed_at",
      "trace_id_hash",
      "viewport_class",
      "surface_id",
      "visual_diff_score",
      "contrast_ratio",
      "interaction_count",
      "layout_shift_score",
      "asset_count",
      "permission_code",
      "dependency_id",
      "vulnerability_id_hash",
      "data_contract_id",
      "privacy_rule_code",
      "exposure_class",
      "request_count",
      "cache_hit_ratio",
      "cpu_ms",
      "memory_mb",
      "storage_bytes",
      "network_bytes",
      "external_cost_microunits",
      "model_units"
    ],
    "forbidden_field_patterns": [
      "content",
      "body",
      "prompt",
      "message",
      "email",
      "password",
      "secret",
      "token",
      "authorization",
      "cookie"
    ]
  },
  "transport": {
    "mode": "LOCAL_OUTBOX_TO_SERVER_SIDE_RELAY",
    "client_direct_to_central": false,
    "relay_requires_server_side_private_key": true,
    "guardian_path": "/v1/project-events",
    "sentinel_path": "/v1/project-events",
    "incremental_batch_max_events": 50,
    "max_outbox_events": 5000,
    "retry_is_non_destructive": true,
    "relay_private_key_secret_ref": "CHACHA_PROJECT_ASSURANCE_PRIVATE_KEY",
    "project_specific_identity_required_for_external_fleet": true,
    "current_platform_pilot_may_use_central_identity": true,
    "role_endpoints": {
      "guardian": {
        "base_key": "guardian_url",
        "path": "/v1/project-events"
      },
      "sentinel": {
        "base_key": "sentinel_url",
        "path": "/v1/project-events"
      },
      "curator": {
        "base_key": "exchange_url",
        "path": "/v1/peripheral-events"
      },
      "bastion": {
        "base_key": "exchange_url",
        "path": "/v1/peripheral-events"
      },
      "intendant": {
        "base_key": "exchange_url",
        "path": "/v1/peripheral-events"
      }
    }
  },
  "central_authority": {
    "guardian_url": "https://chacha-dev-guardian.chachasan090375.workers.dev",
    "sentinel_url": "https://chacha-dev-sentinel.chachasan090375.workers.dev",
    "assurance_exchange_remains_correlation_plane": true,
    "exchange_url": "https://chacha-dev-assurance-exchange.chachasan090375.workers.dev",
    "curator_status": "CENTRAL_AUTHORITY_NEXT",
    "bastion_status": "CENTRAL_AUTHORITY_NEXT",
    "intendant_status": "CENTRAL_AUTHORITY_NEXT"
  },
  "remediation": {
    "local_agents_may_apply_fix": false,
    "local_agents_may_deploy": false,
    "central_orchestrator_owns_remediation": true,
    "remote_remediation_deferred_to_fleet_control": true
  },
  "economics": {
    "automatic_external_spend_eur": 0
  },
  "peripheral_assurance_network": "dev-hub/config/peripheral-assurance-network.v1.json",
  "communication": {
    "common_exchange": "assurance-exchange",
    "peer_decision_making": false,
    "source_evidence_preserved": true,
    "direct_mutation": false,
    "central_orchestrator_owns_remediation": true,
    "all_five_local_probes_incremental": true
  }
}
