{
  "schema": "chacha.dev/control-plane-state-policy/v1",
  "principles": {
    "single_project_projection": true,
    "append_only_audit_journal": true,
    "hash_chained_events": true,
    "signed_security_checkpoints": true,
    "state_is_rebuildable_from_journal": true,
    "journal_is_source_of_history": true,
    "projection_is_source_of_current_state": true,
    "atomic_projection_updates": true,
    "no_secret_values_in_state": true,
    "private_signing_keys_never_enter_state": true,
    "evidence_references_not_evidence_copies": true,
    "production_decisions_are_auditable": true,
    "lifecycle_stage_changes_are_audited_transactions": true,
    "project_control_transaction_receipts_are_recovery_evidence": true,
    "recovery_never_rewrites_audit_history": true,
    "recovery_fault_injection_is_sandbox_only": true
  },
  "storage": {
    "runtime_root": "/opt/chacha-dev/runtime/state",
    "project_state_filename": "state.json",
    "journal_filename": "audit.jsonl",
    "snapshot_directory": "snapshots",
    "checkpoint_directory": "checkpoints",
    "trust_directory": "trust",
    "transaction_root": "/opt/chacha-dev/runtime/transactions",
    "journal_format": "json-lines",
    "journal_encoding": "utf-8"
  },
  "consistency": {
    "projection_version_starts_at": 1,
    "event_sequence_starts_at": 1,
    "event_digest": "sha256-canonical-json",
    "chain_field": "previous_event_digest",
    "signed_checkpoint_algorithm": "Ed25519",
    "atomic_write_strategy": "temp-file-fsync-rename",
    "reject_version_regression": true,
    "reject_sequence_gap": true,
    "reject_chain_break": true,
    "reject_invalid_signed_checkpoint": true,
    "lifecycle_transition_rechecks_integrity_before_and_after_commit": true
  },
  "state_sections": [
    "identity",
    "lifecycle",
    "architecture",
    "capabilities",
    "providers",
    "execution",
    "evidence",
    "approvals",
    "risks",
    "decisions",
    "recovery",
    "operations"
  ],
  "event_types": [
    "PROJECT_INITIALIZED",
    "STATE_PATCHED",
    "LIFECYCLE_TRANSITION",
    "DECISION_RECORDED",
    "APPROVAL_RECORDED",
    "RISK_ACCEPTANCE_RECORDED",
    "PROVIDER_BINDING_RECORDED",
    "RUN_RECORDED",
    "EVIDENCE_RECORDED",
    "SNAPSHOT_CREATED",
    "CHECKPOINT_CREATED",
    "CHECKPOINT_SIGNED",
    "TRUST_ANCHOR_RECORDED",
    "SIGNING_KEY_REGISTERED",
    "SIGNING_KEY_ACTIVATED",
    "SIGNING_KEY_ROTATED",
    "SIGNING_KEY_REVOKED",
    "PROJECT_RETIRED"
  ],
  "cryptographic_trust": {
    "policy": "dev-hub/config/cryptographic-trust.v1.json",
    "signed_checkpoint_schema": "chacha.dev/signed-checkpoint/v1",
    "trust_anchor_schema": "chacha.dev/trust-anchor/v1",
    "release_checkpoint_signature_required": true,
    "retirement_checkpoint_signature_required": true,
    "key_lifecycle_events_audited": true
  },
  "transactions": {
    "receipt_schema": "chacha.dev/control-transaction-receipt/v1",
    "recovery_policy": "dev-hub/config/transaction-recovery.v1.json",
    "recovery_report_schema": "chacha.dev/transaction-recovery-report/v1",
    "recovery_drill_policy": "dev-hub/config/recovery-drill.v1.json",
    "recovery_drill_report_schema": "chacha.dev/recovery-drill-report/v1",
    "project_lock_required": true,
    "journal_authoritative_on_partial_commit": true,
    "pending_transaction_blocks_lifecycle_promotion": true,
    "evidence_ingest_stages_ledger_before_audit_commit": true,
    "projection_rebuild_allowed_only_from_valid_journal": true,
    "ledger_recovery_requires_expected_digest": true,
    "fault_injection_requires_isolated_sandbox": true
  },
  "retention": {
    "journal": "project-lifetime",
    "snapshots": "retain-last-30-and-release-boundaries",
    "checkpoints": "retain-all-manual-and-release-checkpoints",
    "signed_checkpoints": "project-lifetime",
    "public_key_history": "project-lifetime",
    "anchor_receipts": "project-lifetime",
    "control_transaction_receipts": "project-lifetime",
    "recovery_drill_reports": "retain-last-20-and-release-boundaries"
  },
  "backup": {
    "eligible_for_nas_backup": true,
    "include_state_projection": true,
    "include_audit_journal": true,
    "include_snapshots": true,
    "include_checkpoints": true,
    "include_signed_checkpoints": true,
    "include_public_key_history": true,
    "include_control_transaction_receipts": true,
    "include_recovery_drill_reports": true,
    "exclude_private_signing_keys": true
  }
}
