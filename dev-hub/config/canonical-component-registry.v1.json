{
  "schema": "chacha.dev/canonical-component-registry/v1",
  "version": "1.0.0",
  "authority": "chacha-dev-platform",
  "provided_capabilities": [
    "canonical-component-registry-read",
    "runtime-path-observe"
  ],
  "policy": {
    "single_authority": true,
    "read_only_consumers": true,
    "runtime_observation_never_promotes_truth": true,
    "generic_repository_search_fallback_forbidden": true,
    "automatic_external_spend_eur": 0
  },
  "components": {
    "chacha-dev-platform": {
      "component_id": "chacha-dev-platform",
      "paths": {
        "source_root": "/opt/chacha-dev/platform/current",
        "release_root": "/opt/chacha-dev/platform/releases",
        "current_link": "/opt/chacha-dev/platform/current",
        "runtime_root": "/opt/chacha-dev/runtime",
        "state_root": "/opt/chacha-dev/runtime/state/chacha-dev-platform",
        "evidence_root": "/opt/chacha-dev/runtime/evidence/chacha-dev-platform",
        "persistent_root": "/opt/chacha-dev/runtime"
      }
    },
    "wfgg": {
      "component_id": "wfgg",
      "paths": {
        "source_root": "/opt/chacha-dev/projects/wfgg/workspace",
        "runtime_root": "/opt/chacha-dev/runtime",
        "state_root": "/opt/chacha-dev/runtime/state/wfgg",
        "evidence_root": "/opt/chacha-dev/runtime/evidence/wfgg",
        "persistent_root": "/opt/chacha-dev/projects/wfgg"
      }
    }
  }
}
