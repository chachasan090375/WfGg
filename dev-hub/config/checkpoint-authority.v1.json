{"schema":"chacha.dev/checkpoint-authority/v1","version":"1.0.0","authority":"PRIMARY_CHECKPOINT_RECONCILIATION_POLICY","purpose":"Prevent stale conversation checkpoints or historical summaries from overriding newer persisted ChaCha DEV state.","invariants":{"persistent_runtime_and_governed_receipts_outrank_conversation_memory":true,"checkpoint_progression_is_monotonic_unless_explicit_rollback_is_proven":true,"older_train_state_must_never_replace_newer_proven_train_state":true,"train_labels_must_match_candidate_revision_and_transaction_path":true,"transaction_paths_and_receipts_must_match_the_current_train":true,"cross_train_receipt_reuse_is_forbidden":true,"current_revision_must_be_verified_before_resuming_mutating_work":true,"active_finalized_claim_requires_runtime_or_governed_receipt_proof":true,"roadmap_shadow_state_must_not_be_confused_with_production_active_state":true,"conversation_summary_is_context_only_not_state_authority":true},"authority_order":["LIVE_PRODUCTION_CURRENT_AND_RUNTIME_STATE","GOVERNED_TRANSACTION_RECEIPTS_AND_LEASES","EXACT_SHA_GITHUB_QUALIFICATION_EVIDENCE","CANONICAL_ROADMAP_AND_CCR","CONVERSATION_CHECKPOINT_OR_SUMMARY"],"resume_preflight":{"required":["resolve_live_current_revision","resolve_active_or_terminal_promotion_transaction","match_train_id_candidate_sha_tree_and_transaction_path","reconcile_physical_releases","reconcile_roadmap_shadow_vs_production_status"],"on_mismatch":"STOP_AND_RECONSTRUCT_CHECKPOINT_FROM_PERSISTED_EVIDENCE","forbid":"CONTINUE_FROM_STALE_OR_AMBIGUOUS_CONVERSATION_STATE"},"incident_class":"STALE_CHECKPOINT_REGRESSION","required_sinks":["direct-operator","central-orchestrator","run-controller","guardian","sentinel","progress-reporting","canonical-component-registry","canonical-architecture-index"],"application_state":{"decided":true,"persisted_in_repository":true,"propagated_to_runtime":false,"verified_active_in_runtime":false},"incident_note":"Added after a conversation-state regression incorrectly returned to F08 and reused F09 transaction identifiers while handling later trains. This policy makes persisted evidence authoritative and forbids cross-train state contamination."}