      "env_refs": [
        "d1-binding"
      ],
      "secret_refs": [],
      "observability_hooks": [
        "query-errors"
      ],
      "owner": "radar-data-role"
    },
    {
      "id": "radar-connector",
      "type": "service",
      "path": "radar-vps",
      "runtime": "linux-systemd-go",
      "framework": "go",
      "interfaces": [
        "signed-https"
      ],
      "depends_on": [],
      "commands": {},
      "artifacts": [
        "radar-connector",
        "radar-native-template"
