      "secret_refs": [
        "worker-secrets"
      ],
      "observability_hooks": [
        "structured-logs",
        "request-errors"
      ],
      "owner": "radar-backend-role"
    },
    {
      "id": "radar-d1",
      "type": "database",
      "path": "radar-release",
      "runtime": "cloudflare-d1",
      "framework": "d1",
      "interfaces": [
        "sql"
      ],
      "depends_on": [],
      "commands": {},
      "artifacts": [
        "schema-migrations"
