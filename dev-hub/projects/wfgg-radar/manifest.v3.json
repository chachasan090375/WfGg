      "path": ".radar-release-src",
      "runtime": "cloudflare-workers",
      "framework": "wrangler",
      "package_manager": "npm",
      "interfaces": [
        "https-api"
      ],
      "depends_on": [
        "radar-d1",
        "radar-connector"
