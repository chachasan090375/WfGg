{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "chacha.dev/contracts/canonical-component-paths/v1",
  "title": "ChaCha DEV Canonical Component Path Extension",
  "description": "Extension contract consumed by Canonical Path Resolver. It does not define a second registry; these fields belong to the authoritative Canonical Component Registry record.",
  "type": "object",
  "required": ["component_id", "paths"],
  "properties": {
    "component_id": {"type": "string", "minLength": 1},
    "owner": {"type": "string"},
    "lifecycle": {"type": "string"},
    "paths": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "source_root": {"$ref": "#/$defs/pathOrCandidates"},
        "release_root": {"$ref": "#/$defs/pathOrCandidates"},
        "current_link": {"$ref": "#/$defs/pathOrCandidates"},
        "runtime_root": {"$ref": "#/$defs/pathOrCandidates"},
        "state_root": {"$ref": "#/$defs/pathOrCandidates"},
        "evidence_root": {"$ref": "#/$defs/pathOrCandidates"},
        "persistent_root": {"$ref": "#/$defs/pathOrCandidates"},
        "writable_roots": {
          "oneOf": [
            {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
            {"$ref": "#/$defs/candidateSet"}
          ]
        },
        "systemd_unit": {
          "oneOf": [
            {"type": "string", "minLength": 1},
            {"$ref": "#/$defs/candidateSet"}
          ]
        },
        "endpoints": {
          "oneOf": [
            {"type": "object"},
            {"$ref": "#/$defs/candidateSet"}
          ]
        },
        "ports": {
          "oneOf": [
            {"type": "object"},
            {"type": "array"},
            {"type": "integer"},
            {"$ref": "#/$defs/candidateSet"}
          ]
        }
      }
    }
  },
  "additionalProperties": true,
  "$defs": {
    "candidateSet": {
      "type": "object",
      "required": ["candidates"],
      "properties": {
        "candidates": {"type": "array", "minItems": 1, "uniqueItems": true}
      },
      "additionalProperties": false
    },
    "pathOrCandidates": {
      "oneOf": [
        {"type": "string", "minLength": 1},
        {"$ref": "#/$defs/candidateSet"}
      ]
    }
  }
}
