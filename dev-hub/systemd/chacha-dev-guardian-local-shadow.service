[Unit]
Description=ChaCha DEV Guardian Local SQLite Shadow
After=network.target

[Service]
Type=simple
User=root
Environment=CHACHA_GUARDIAN_LOCAL_BIND=127.0.0.1
Environment=CHACHA_GUARDIAN_LOCAL_PORT=8871
Environment=CHACHA_GUARDIAN_LOCAL_DB=/opt/chacha-dev/runtime/sovereign-state/shadow/guardian.db
ExecStart=/usr/bin/node /opt/chacha-dev/platform/current/dev-hub/bin/guardian-local-runtime.mjs
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/opt/chacha-dev/runtime/sovereign-state

[Install]
WantedBy=multi-user.target
