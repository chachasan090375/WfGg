[Unit]
Description=ChaCha DEV out-of-band emergency control bridge
Wants=network-online.target
After=network-online.target
ConditionPathExists=/opt/chacha-dev/emergency-bridge/current/emergency-control-bridge.py

[Service]
Type=simple
User=root
Group=root
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/bin/python3 /opt/chacha-dev/emergency-bridge/current/emergency-control-bridge.py --command-url https://raw.githubusercontent.com/chachasan090375/WfGg/chacha-emergency-control/dev-hub/control/emergency-stop-command.json --poll-seconds 10 --controller /opt/chacha-dev/emergency-bridge/current/emergency-stop-controller.py
Restart=always
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/chacha-dev/runtime/control
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
LockPersonality=true
MemoryDenyWriteExecute=true

[Install]
WantedBy=multi-user.target
