[Unit]
Description=ChaCha DEV Agent Observation Bus Health
After=network-online.target
[Service]
Type=oneshot
User=root
WorkingDirectory=/opt/chacha-dev/platform/current
ExecStart=/usr/bin/python3 /opt/chacha-dev/platform/current/dev-hub/bin/agent_observation_bus_health.py --repo-root /opt/chacha-dev/platform/current --runtime-root /opt/chacha-dev/runtime --policy /opt/chacha-dev/platform/current/dev-hub/config/agent-observation-bus.v1.json --mode lightweight
