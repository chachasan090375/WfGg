[Unit]
Description=ChaCha DEV Intendant governed hygiene cycle
After=network-online.target
Wants=network-online.target
ConditionPathExists=/opt/chacha-dev/platform/current/dev-hub/bin/intendant-hygiene-cycle.py

[Service]
Type=oneshot
User=root
Group=root
WorkingDirectory=/opt/chacha-dev/platform/current
ExecStart=/usr/bin/python3 /opt/chacha-dev/platform/current/dev-hub/bin/intendant-hygiene-cycle.py --repo-root /opt/chacha-dev/platform/current --runtime-root /opt/chacha-dev/runtime --platform-root /opt/chacha-dev/platform --policy /opt/chacha-dev/platform/current/dev-hub/config/intendant-hygiene-cycle.v1.json --consolidation-policy /opt/chacha-dev/platform/current/dev-hub/config/platform-consolidation.v1.json --guardian-client /opt/chacha-dev/platform/current/dev-hub/bin/guardian-client.py --guardian-policy /opt/chacha-dev/platform/current/dev-hub/config/guardian-runtime-policy.v1.json --guardian-coverage /opt/chacha-dev/runtime/guardian/coverage-latest.json --council /opt/chacha-dev/platform/current/dev-hub/bin/architecture-council-platform-consolidation-v7.py --consolidator /opt/chacha-dev/platform/current/dev-hub/bin/intendant-platform-consolidator.py --hygiene-executor /opt/chacha-dev/platform/current/dev-hub/bin/central-platform-hygiene-executor.py
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=false
ReadOnlyPaths=/opt/chacha-dev/runtime/secrets/central-learning-key.pem
ReadWritePaths=/opt/chacha-dev/runtime/intendant /opt/chacha-dev/platform/releases /opt/chacha-dev/runtime/tmp /tmp
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
MemoryMax=192M
TasksMax=48
