[Unit]
Description=ChaCha DEV central learning relay pull
Wants=network-online.target
After=network-online.target
ConditionPathExists=/opt/chacha-dev/runtime/secrets/central-learning-key.pem

[Service]
Type=oneshot
User=root
Group=root
Environment=PYTHONUNBUFFERED=1
Environment=CHACHA_NAS_ADAPTER=/opt/chacha-dev/adapters/nas-ssh/current/nas-ssh-adapter
ExecStart=/usr/bin/python3 /opt/chacha-dev/learning-relay/current/central-learning-relay-puller.py --relay-url https://chacha-dev-learning-relay.chachasan090375.workers.dev --private-key /opt/chacha-dev/runtime/secrets/central-learning-key.pem --ingest /opt/chacha-dev/learning-relay/current/learning-delta-ingest.py --db /opt/chacha-dev/runtime/knowledge/learning-deltas.db --anomaly-queue /opt/chacha-dev/runtime/learning/anomaly-queue --batch-limit 25 --experience-db /opt/chacha-dev/runtime/knowledge/experience.db --global-indexer /opt/chacha-dev/learning-relay/current/global-project-memory-index.py --global-index /opt/chacha-dev/runtime/knowledge/global-project-memory-index.json
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadOnlyPaths=/opt/chacha-dev/runtime/secrets/central-learning-key.pem /opt/chacha-dev/adapters/nas-ssh/current
ReadWritePaths=/opt/chacha-dev/runtime/knowledge /opt/chacha-dev/runtime/learning
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
MemoryMax=192M
TasksMax=32
