[Unit]
Description=ChaCha DEV Guardian-governed production lineage feedback
Wants=network-online.target
After=network-online.target chacha-dev-universal-learning-flush.service

[Service]
Type=oneshot
User=root
Group=root
Environment=PYTHONPATH=/opt/chacha-dev/platform/current/dev-hub/bin
ExecStart=/usr/bin/python3 /opt/chacha-dev/platform/current/dev-hub/bin/guardian-governed-production-lineage-feedback.py
ExecStartPost=/usr/bin/systemctl start chacha-dev-component-confidence.service
ExecStartPost=/usr/bin/systemctl start chacha-dev-central-memory-assimilation.service
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=false
MemoryMax=256M
TasksMax=32
