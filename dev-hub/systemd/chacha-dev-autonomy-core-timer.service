[Unit]
Description=ChaCha DEV Autonomy Core timer-triggered supervision loop
After=network-online.target chacha-dev-direct-operator.service
Wants=network-online.target
ConditionPathExists=/opt/chacha-dev/platform/current/dev-hub/bin/autonomy-loop-runner.py

[Service]
Environment=CHACHA_AUTONOMY_TRIGGER=timer
Environment=PYTHONDONTWRITEBYTECODE=1
Type=oneshot
User=root
Group=root
WorkingDirectory=/opt/chacha-dev/platform/current
ExecStart=/usr/bin/python3 /opt/chacha-dev/platform/current/dev-hub/bin/autonomy-timer-trigger-wrapper.py --repo-root /opt/chacha-dev/platform/current --runtime-root /opt/chacha-dev/runtime
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/opt/chacha-dev/runtime/autonomy-core
RestrictAddressFamilies=AF_UNIX
MemoryMax=128M
TasksMax=32
