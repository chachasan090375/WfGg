[Unit]
Description=ChaCha DEV emergency stop graphical safety surface
After=network.target
ConditionPathExists=/opt/chacha-dev/platform/current/dev-hub/bin/emergency-stop-surface.py

[Service]
Type=simple
User=root
Group=root
ExecStart=/usr/bin/python3 /opt/chacha-dev/platform/current/dev-hub/bin/emergency-stop-surface.py --bind 127.0.0.1 --port 8788
Restart=on-failure
RestartSec=2
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/chacha-dev/runtime/control
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

[Install]
WantedBy=multi-user.target
