[Unit]
Description=ChaCha DEV Agent Evolution Daily Cycle
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=root
WorkingDirectory=/opt/chacha-dev/platform/current
ExecStart=/usr/bin/python3 /opt/chacha-dev/platform/current/dev-hub/bin/agent_evolution_daily_cycle.py --repo-root /opt/chacha-dev/platform/current --runtime-root /opt/chacha-dev/runtime
