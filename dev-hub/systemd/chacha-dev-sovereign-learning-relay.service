[Unit]
Description=ChaCha DEV Sovereign Learning Relay Local State Runtime
After=network.target

[Service]
Type=simple
User=root
Group=root
Environment=CHACHA_D1_LOCAL_BIND=127.0.0.1
Environment=CHACHA_D1_LOCAL_PORT=8874
Environment=CHACHA_D1_LOCAL_SERVICE=learning-relay
Environment=CHACHA_D1_LOCAL_DB=/opt/chacha-dev/runtime/sovereign-state/primary/learning-relay.db
Environment=CHACHA_D1_LOCAL_WORKER=/opt/chacha-dev/platform/current/dev-hub/learning-relay/worker.js
ExecStart=/usr/bin/node /opt/chacha-dev/platform/current/dev-hub/bin/d1-worker-local-runtime.mjs
Restart=on-failure
RestartSec=2
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/opt/chacha-dev/runtime/sovereign-state

[Install]
WantedBy=multi-user.target
