[Unit]
Description=ChaCha DEV Cognitive Memory Fabric event-triggered shadow tiering
After=network-online.target
Wants=network-online.target

[Service]
Environment=PYTHONDONTWRITEBYTECODE=1
Type=oneshot
User=root
Group=root
Environment=PYTHONPATH=/opt/chacha-dev/platform/current/dev-hub/bin
ExecStart=/usr/bin/python3 /opt/chacha-dev/platform/current/dev-hub/bin/cognitive-memory-tiering-event-drain.py --policy /opt/chacha-dev/platform/current/dev-hub/config/cognitive-memory-fabric.v1.json
NoNewPrivileges=true
PrivateTmp=true
MemoryMax=192M
TasksMax=24
