[Unit]
Description=ChaCha DEV universal learning outbox flush
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=root
Group=root
ExecStart=/usr/bin/python3 /opt/chacha-dev/platform/current/dev-hub/bin/universal-learning-producer.py flush --transport local
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/chacha-dev/runtime/learning /opt/chacha-dev/runtime/knowledge
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
MemoryMax=128M
TasksMax=24
