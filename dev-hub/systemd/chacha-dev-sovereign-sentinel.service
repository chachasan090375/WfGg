[Unit]
Description=ChaCha DEV Sovereign Sentinel Local State Runtime
After=network.target

[Service]
Type=simple
User=root
Group=root
Environment=CHACHA_D1_LOCAL_BIND=127.0.0.1
Environment=CHACHA_D1_LOCAL_PORT=8872
Environment=CHACHA_D1_LOCAL_SERVICE=sentinel
Environment=CHACHA_D1_LOCAL_DB=/opt/chacha-dev/runtime/sovereign-state/primary/sentinel.db
Environment=CHACHA_D1_LOCAL_WORKER=/opt/chacha-dev/platform/current/dev-hub/sentinel/worker.js
Environment=CHACHA_ASSURANCE_EXCHANGE_URL=http://127.0.0.1:8873
ExecStart=/usr/bin/node /opt/chacha-dev/platform/current/dev-hub/bin/d1-worker-local-runtime.mjs
Restart=on-failure
RestartSec=2
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/opt/chacha-dev/runtime/sovereign-state

[Install]
WantedBy=multi-user.target
