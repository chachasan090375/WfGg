[Unit]
Description=ChaCha DEV private Direct Operator surface with deterministic control plane
After=network-online.target tailscaled.service
Wants=network-online.target tailscaled.service
ConditionPathExists=/opt/chacha-dev/platform/current/dev-hub/bin/direct-operator-control-plane-gateway.py
ConditionPathExists=/opt/chacha-dev/platform/current/dev-hub/bin/direct-operator-service.py

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/opt/chacha-dev/platform/current
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/bin/python3 /opt/chacha-dev/platform/current/dev-hub/bin/direct-operator-control-plane-gateway.py --repo-root /opt/chacha-dev/platform/current --runtime-root /opt/chacha-dev/runtime --direct-policy /opt/chacha-dev/platform/current/dev-hub/config/direct-operator.v1.json --control-policy /opt/chacha-dev/platform/current/dev-hub/config/platform-control-plane.v1.json
Restart=on-failure
RestartSec=2
KillMode=mixed
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadOnlyPaths=/opt/chacha-dev/runtime/secrets
ReadWritePaths=/opt/chacha-dev/runtime/direct-operator /opt/chacha-dev/runtime/human-interface /opt/chacha-dev/runtime/control /opt/chacha-dev/runtime/progress /opt/chacha-dev/runtime/provider-economics /opt/chacha-dev/runtime/secrets/project-assurance /opt/chacha-dev/runtime/adapter-auto-remediation /opt/chacha-dev/runtime/health /opt/chacha-dev/runtime/registries /opt/chacha-dev/runtime/canonical-registry /opt/chacha-dev/runtime/projects /opt/chacha-dev/adapters /opt/chacha-dev/runtime/state /opt/chacha-dev/runtime/evidence /opt/chacha-dev/runtime/plans /opt/chacha-dev/runtime/runs /opt/chacha-dev/runtime/transactions /opt/chacha-dev/runtime/locks /opt/chacha-dev/runtime/governance/operator-directives /opt/chacha-dev/runtime/learning /opt/chacha-dev/runtime/agent-observation /opt/chacha-dev/runtime/agent-evolution /opt/chacha-dev/runtime/technical-design-results
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
MemoryMax=192M
TasksMax=48

[Install]
WantedBy=multi-user.target
