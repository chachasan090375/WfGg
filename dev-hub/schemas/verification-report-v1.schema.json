{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chacha.dev/schemas/verification-report-v1.schema.json",
  "title": "ChaCha DEV HUB Verification Report V1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "project", "task_id", "verifier", "method", "status", "observed_at", "checks", "source_result_digest"],
  "properties": {
    "schema": {"const": "chacha.dev/verification-report/v1"},
    "project": {"type": "string"},
    "task_id": {"type": "string"},
    "verifier": {"type": "string"},
    "method": {"enum": ["machine", "independent-agent", "human"]},
    "status": {"enum": ["VERIFIED", "REJECTED", "NEEDS_INDEPENDENT_CHECK"]},
    "observed_at": {"type": "string"},
    "source_result_digest": {"type": "string"},
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "status"],
        "properties": {
          "id": {"type": "string"},
          "status": {"enum": ["PASS", "FAIL", "SKIP", "NEEDS_CHECK"]},
          "detail": {"type": "string"}
        }
      }
    },
    "notes": {"type": "array", "items": {"type": "string"}},
    "verified_task_result": {"type": ["object", "null"]}
  }
}
