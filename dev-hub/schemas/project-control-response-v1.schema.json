{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chacha.dev/schemas/project-control-response-v1.schema.json",
  "title": "ChaCha DEV HUB Project Control Response V1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "project", "operation", "status", "observed_at", "summary", "details", "blockers"],
  "properties": {
    "schema": {"const": "chacha.dev/project-control-response/v1"},
    "project": {"type": "string"},
    "operation": {"type": "string"},
    "status": {"enum": ["READY", "BLOCKED", "AWAITING_APPROVAL", "DEGRADED", "UNKNOWN", "COMPLETE", "OK", "FAILED"]},
    "observed_at": {"type": "string"},
    "summary": {"type": "string"},
    "details": {"type": "object", "additionalProperties": true},
    "blockers": {"type": "array", "items": {"type": "string"}},
    "next_actions": {"type": "array", "items": {"type": "string"}},
    "artifacts": {"type": "array", "items": {"type": "object", "additionalProperties": true}}
  }
}
