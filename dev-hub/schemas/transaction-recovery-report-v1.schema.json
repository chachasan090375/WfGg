{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chacha.dev/schemas/transaction-recovery-report-v1.schema.json",
  "title": "ChaCha DEV HUB Transaction Recovery Report V1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "project", "transaction_id", "operation", "receipt_status", "assessment", "apply_requested", "actions", "blockers", "observed_at"],
  "properties": {
    "schema": {"const": "chacha.dev/transaction-recovery-report/v1"},
    "project": {"type": "string", "minLength": 1},
    "transaction_id": {"type": "string", "minLength": 1},
    "operation": {"type": "string"},
    "receipt_status": {"type": "string"},
    "assessment": {"enum": ["TERMINAL", "SAFE_TO_ABORT", "SAFE_TO_FINALIZE", "ALREADY_EFFECTIVE", "REPAIRABLE", "MANUAL_REVIEW", "INVALID"]},
    "apply_requested": {"type": "boolean"},
    "authoritative_event": {"type": ["object", "null"], "additionalProperties": true},
    "journal": {"type": "object", "additionalProperties": true},
    "projection": {"type": "object", "additionalProperties": true},
    "ledger": {"type": "object", "additionalProperties": true},
    "actions": {"type": "array", "items": {"type": "string"}},
    "blockers": {"type": "array", "items": {"type": "string"}},
    "recovery_outcome": {"type": ["string", "null"]},
    "observed_at": {"type": "string"}
  }
}
