{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "chacha.dev/learning-delta/v1",
  "type": "object",
  "required": [
    "schema",
    "delta_id",
    "project_id",
    "source_id",
    "source_kind",
    "deployment_id",
    "sequence",
    "observed_at",
    "changes",
    "privacy"
  ],
  "properties": {
    "schema": {
      "const": "chacha.dev/learning-delta/v1"
    },
    "delta_id": {
      "type": "string",
      "minLength": 8,
      "maxLength": 128
    },
    "project_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "source_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "source_kind": {
      "enum": [
        "core-orchestrator",
        "domain-orchestrator",
        "foundry",
        "agent",
        "embedded-application-agent",
        "learning-module",
        "runtime-monitor"
      ]
    },
    "deployment_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "sequence": {
      "type": "integer",
      "minimum": 1
    },
    "observed_at": {
      "type": "string",
      "minLength": 10
    },
    "changes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object"
      }
    },
    "anomaly": {
      "type": [
        "object",
        "null"
      ]
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "privacy": {
      "type": "object",
      "required": [
        "raw_user_content",
        "contains_secrets",
        "personal_data_class"
      ],
      "properties": {
        "raw_user_content": {
          "const": false
        },
        "contains_secrets": {
          "const": false
        },
        "personal_data_class": {
          "enum": [
            "none",
            "aggregated",
            "policy-authorized"
          ]
        }
      }
    }
  }
}
