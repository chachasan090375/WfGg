{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chacha.dev/schemas/adapter-promotion-report-v1.schema.json",
  "title": "ChaCha DEV HUB Adapter Promotion Report V1",
  "type": "object",
  "additionalProperties": true,
  "required": ["schema", "adapter", "current_status", "target_status", "transition", "eligible", "applied", "blockers", "required_evidence", "observed_evidence"],
  "properties": {
    "schema": {"const": "chacha.dev/adapter-promotion-report/v1"},
    "adapter": {"type": "string", "minLength": 1},
    "current_status": {"type": "string", "minLength": 1},
    "target_status": {"type": "string", "minLength": 1},
    "transition": {"type": "string", "minLength": 3},
    "eligible": {"type": "boolean"},
    "applied": {"type": "boolean"},
    "production_capable": {"type": "boolean"},
    "approval_required": {"type": "boolean"},
    "approval_id": {"type": ["string", "null"]},
    "executable_before": {"type": ["string", "null"]},
    "executable_after": {"type": ["string", "null"]},
    "required_evidence": {"type": "array", "items": {"type": "string"}},
    "observed_evidence": {"type": "object", "additionalProperties": true},
    "blockers": {"type": "array", "items": {"type": "string"}},
    "actor": {"type": ["string", "null"]},
    "registry_digest_before": {"type": ["string", "null"]},
    "registry_digest_after": {"type": ["string", "null"]},
    "receipt": {"type": ["string", "null"]}
  }
}
