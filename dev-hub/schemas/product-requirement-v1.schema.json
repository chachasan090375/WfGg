{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chacha.dev/schemas/product-requirement-v1.schema.json",
  "title": "ChaCha DEV HUB Product Requirement V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "project",
    "id",
    "title",
    "objective",
    "functional_requirements",
    "acceptance_criteria",
    "constraints",
    "source"
  ],
  "properties": {
    "schema": {
      "const": "chacha.dev/product-requirement/v1"
    },
    "project": {
      "type": "string",
      "minLength": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._-]+$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "objective": {
      "type": "string",
      "minLength": 1
    },
    "functional_requirements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "acceptance_criteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "constraints": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "must_preserve": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "unknowns": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "domains": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "product-domain",
          "frontend",
          "backend-api",
          "data",
          "integration",
          "security",
          "testing",
          "platform",
          "sre-observability",
          "performance",
          "recovery",
          "release",
          "documentation"
        ]
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "reference"
      ],
      "properties": {
        "kind": {
          "enum": [
            "human-cahier-des-charges",
            "product-spec",
            "issue",
            "incident-followup",
            "other"
          ]
        },
        "reference": {
          "type": "string",
          "minLength": 1
        },
        "captured_at": {
          "type": "string"
        }
      }
    },
    "technical_constraints": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "must_use": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "must_not_use": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "production_change_requires_approval": {
          "type": "boolean"
        },
        "readonly_external_system": {
          "type": "boolean"
        }
      }
    }
  }
}
