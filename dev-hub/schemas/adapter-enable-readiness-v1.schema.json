{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chacha.dev/schemas/adapter-enable-readiness-v1.schema.json",
  "title": "ChaCha DEV HUB Adapter Enablement Readiness V1",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema",
    "adapter",
    "provider",
    "current_status",
    "target_status",
    "status",
    "registry_mutated",
    "promotion_eligible",
    "blockers",
    "observed_at"
  ],
  "properties": {
    "schema": {"const": "chacha.dev/adapter-enable-readiness/v1"},
    "adapter": {"type": "string", "minLength": 1},
    "provider": {"type": "string", "minLength": 1},
    "current_status": {"type": "string"},
    "target_status": {"const": "ENABLED"},
    "status": {"enum": ["READY_FOR_ENABLEMENT", "BLOCKED"]},
    "registry_mutated": {"const": false},
    "execution_kinds": {"type": "array", "items": {"type": "string"}},
    "executable": {"type": ["string", "null"]},
    "executable_digest": {"type": ["string", "null"]},
    "repeatability_results": {"type": "array", "minItems": 3},
    "health_snapshot": {"type": "string"},
    "health_snapshot_digest": {"type": "string"},
    "rollback_registry": {"type": "string"},
    "rollback_registry_digest": {"type": "string"},
    "enablement_evidence": {"type": ["string", "null"]},
    "enablement_evidence_digest": {"type": ["string", "null"]},
    "promotion_plan": {"type": ["string", "null"]},
    "promotion_plan_digest": {"type": ["string", "null"]},
    "promotion_eligible": {"type": "boolean"},
    "blockers": {"type": "array", "items": {"type": "string"}},
    "processes": {"type": "array"},
    "observed_at": {"type": "string", "minLength": 1}
  }
}
