{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chacha.dev/schemas/run-record-v1.schema.json",
  "title": "ChaCha DEV HUB Run Record V1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "run_id", "project", "transition", "mode", "started_at", "waves", "summary"],
  "properties": {
    "schema": {"const": "chacha.dev/run-record/v1"},
    "run_id": {"type": "string"},
    "project": {"type": "string"},
    "transition": {"type": "string"},
    "mode": {"enum": ["dispatch-only", "execute"]},
    "started_at": {"type": "string"},
    "finished_at": {"type": ["string", "null"]},
    "waves": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["index", "tasks"],
        "properties": {
          "index": {"type": "integer", "minimum": 1},
          "tasks": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["task_id", "status"],
              "properties": {
                "task_id": {"type": "string"},
                "status": {"enum": ["PREPARED", "BLOCKED", "DISPATCHED", "SUCCEEDED", "FAILED", "TIMED_OUT", "SKIPPED"]},
                "provider_bindings": {"type": "array"},
                "dispatch_envelope": {"type": ["string", "null"]},
                "task_result": {"type": ["string", "null"]},
                "attempts": {"type": "integer", "minimum": 0},
                "exit_code": {"type": ["integer", "null"]},
                "failure_class": {"type": ["string", "null"]},
                "started_at": {"type": ["string", "null"]},
                "finished_at": {"type": ["string", "null"]},
                "stdout_digest": {"type": ["string", "null"]},
                "stderr_digest": {"type": ["string", "null"]},
                "blockers": {"type": "array", "items": {"type": "string"}}
              }
            }
          }
        }
      }
    },
    "summary": {
      "type": "object",
      "required": ["prepared", "blocked", "dispatched", "succeeded", "failed"],
      "properties": {
        "prepared": {"type": "integer", "minimum": 0},
        "blocked": {"type": "integer", "minimum": 0},
        "dispatched": {"type": "integer", "minimum": 0},
        "succeeded": {"type": "integer", "minimum": 0},
        "failed": {"type": "integer", "minimum": 0}
      }
    },
    "metadata": {"type": "object", "additionalProperties": true}
  }
}
