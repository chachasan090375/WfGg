{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chacha.dev/schemas/control-transaction-receipt-v1.schema.json",
  "title": "ChaCha DEV HUB Control Transaction Receipt V1",
  "type": "object",
  "additionalProperties": true,
  "required": ["schema", "transaction_id", "project", "operation", "status", "updated_at"],
  "properties": {
    "schema": {"const": "chacha.dev/control-transaction-receipt/v1"},
    "transaction_id": {"type": "string", "minLength": 1},
    "project": {"type": "string", "minLength": 1},
    "operation": {"enum": ["advance", "verify-result", "record-control-event"]},
    "status": {
      "enum": [
        "PREPARED",
        "VERIFIED_ONLY",
        "CONTROL_EVENT_COMMITTED_LEDGER_PENDING",
        "COMMIT_UNCERTAIN",
        "COMMITTED",
        "FAILED"
      ]
    },
    "updated_at": {"type": "string"},
    "actor": {"type": "string"},
    "transition": {"type": "string"},
    "pre_version": {"type": "integer", "minimum": 0},
    "post_version": {"type": "integer", "minimum": 0},
    "pre_head_digest": {"type": "string"},
    "post_head_digest": {"type": "string"},
    "evidence_ledger_digest": {"type": "string"},
    "old_ledger_digest": {"type": "string"},
    "new_ledger_digest": {"type": "string"},
    "event_sequence": {"type": ["integer", "string", "null"]},
    "event_digest": {"type": ["string", "null"]},
    "failure": {"type": ["string", "null"]}
  }
}
