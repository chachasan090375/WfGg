{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chacha.dev/schemas/technical-design-plan-v1.schema.json",
  "title": "ChaCha DEV HUB Technical Design Plan V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "project",
    "requirement_id",
    "orchestrator",
    "affected_components",
    "specialist_assignments",
    "architecture_decisions",
    "implementation_gate"
  ],
  "properties": {
    "schema": {
      "const": "chacha.dev/technical-design-plan/v1"
    },
    "project": {
      "type": "string",
      "minLength": 1
    },
    "requirement_id": {
      "type": "string",
      "minLength": 1
    },
    "generated_at": {
      "type": "string"
    },
    "orchestrator": {
      "const": "chacha-dev-architect"
    },
    "affected_components": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "specialist_assignments": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "role",
          "primary",
          "reason",
          "capabilities",
          "responsibilities",
          "outputs"
        ],
        "properties": {
          "role": {
            "type": "string",
            "minLength": 1
          },
          "primary": {
            "type": "boolean"
          },
          "reason": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "capabilities": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          "responsibilities": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "outputs": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          "review_roles": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          }
        }
      }
    },
    "architecture_decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "owner_role",
          "status",
          "question",
          "required_output"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "owner_role": {
            "type": "string"
          },
          "status": {
            "enum": [
              "REQUIRED",
              "NEEDS_INPUT",
              "RESOLVED",
              "NOT_APPLICABLE"
            ]
          },
          "question": {
            "type": "string"
          },
          "required_output": {
            "type": "string"
          },
          "constraints": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "cross_reviews": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "reviewer_role",
          "subjects"
        ],
        "properties": {
          "reviewer_role": {
            "type": "string"
          },
          "subjects": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "implementation_gate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code_generation_allowed",
        "blocking_reasons",
        "required_before_implementation"
      ],
      "properties": {
        "code_generation_allowed": {
          "type": "boolean"
        },
        "blocking_reasons": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "required_before_implementation": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": true
    }
  }
}
