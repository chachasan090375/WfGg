{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chacha.dev/schemas/project-control-request-v1.schema.json",
  "title": "ChaCha DEV HUB Project Control Request V1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "project", "operation"],
  "properties": {
    "schema": {"const": "chacha.dev/project-control-request/v1"},
    "project": {"type": "string", "minLength": 1},
    "operation": {
      "enum": [
        "status",
        "explain",
        "verify-state",
        "plan-transition",
        "schedule",
        "prepare-run",
        "dispatch",
        "verify-result",
        "record-control-event",
        "advance",
        "crypto-verify"
      ]
    },
    "arguments": {"type": "object", "additionalProperties": true},
    "actor": {"type": "string"},
    "request_id": {"type": "string"}
  }
}
