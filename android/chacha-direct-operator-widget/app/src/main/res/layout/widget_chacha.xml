<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@drawable/widget_bg"
    android:paddingStart="14dp"
    android:paddingEnd="8dp">
    <TextView
        android:id="@+id/widget_prompt"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:text="@string/widget_prompt"
        android:textColor="#EEEAF7"
        android:textSize="15sp"
        android:maxLines="1"
        android:ellipsize="end" />
    <ImageButton
        android:id="@+id/widget_mic"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:background="@android:color/transparent"
        android:src="@android:drawable/ic_btn_speak_now"
        android:tint="#B8A8FF"
        android:contentDescription="Dicter" />
    <TextView
        android:id="@+id/widget_status"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:gravity="center"
        android:text="●"
        android:textColor="#71D68A"
        android:textSize="20sp"
        android:contentDescription="État ChaCha DEV" />
</LinearLayout>
