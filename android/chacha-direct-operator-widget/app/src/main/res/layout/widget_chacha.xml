<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_bg"
    android:padding="12dp">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <TextView
            android:id="@+id/widget_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="💨  ChaCha j’ai pété"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:textSize="14sp" />
        <TextView
            android:id="@+id/widget_global"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="86%"
            android:textColor="#C9BBFF"
            android:textStyle="bold"
            android:textSize="13sp" />
    </LinearLayout>
    <ProgressBar
        android:id="@+id/widget_global_progress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="6dp"
        android:layout_marginTop="5dp"
        android:max="100"
        android:progress="86"
        android:progressTint="#8B68FF"
        android:progressBackgroundTint="#3B3646" />
    <TextView
        android:id="@+id/widget_prompt"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:text="@string/widget_prompt"
        android:textColor="#EEEAF7"
        android:textSize="14sp"
        android:maxLines="3"
        android:ellipsize="end" />
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <ProgressBar
            android:id="@+id/widget_work_progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="0dp"
            android:layout_height="6dp"
            android:layout_weight="1"
            android:max="100"
            android:progress="0"
            android:progressTint="#6DE0B6"
            android:progressBackgroundTint="#3B3646" />
        <ImageButton
            android:id="@+id/widget_mic"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@android:color/transparent"
            android:src="@android:drawable/ic_btn_speak_now"
            android:tint="#C7B9FF"
            android:contentDescription="Dicter" />
        <TextView
            android:id="@+id/widget_status"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:gravity="center"
            android:text="●"
            android:textColor="#71D68A"
            android:textSize="17sp"
            android:contentDescription="État ChaCha DEV" />
    </LinearLayout>
</LinearLayout>